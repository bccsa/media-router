{
    "name": "@media-router/plugin-n1-mixer-302m",
    "version": "2.0.0",
    "private": true,
    "description": "N-1 mix-minus audio mixer on the 302M bus — each output gets all inputs except its own paired input",
    "mediaRouter": {
        "pluginId": "n1-mixer-302m",
        "displayName": "N-1 Audio Mixer (302M)",
        "description": "Broadcast mix-minus on the 302M bus: each output hears all inputs except its own return, timeline-aligned",
        "color": "#a855f7",
        "icon": "shuffle",
        "category": "processing",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "pairCount": {
                    "type": "number",
                    "minimum": 2,
                    "maximum": 16,
                    "default": 4,
                    "title": "Pair Count",
                    "description": "Number of input/output pairs"
                },
                "channels": {
                    "type": "number",
                    "enum": [1, 2, 4, 6, 8],
                    "x-enumLabels": {
                        "1": "Mono",
                        "2": "Stereo",
                        "4": "4 channels",
                        "6": "6 channels",
                        "8": "8 channels"
                    },
                    "default": 2,
                    "title": "Channels",
                    "description": "Mix width of every pair. 302M carries 2, 4, 6 or 8; mono is encoded as dual-mono stereo."
                },
                "pcmBitDepth": {
                    "type": "number",
                    "enum": [16, 24],
                    "x-enumLabels": {
                        "16": "16-bit (lower CPU)",
                        "24": "24-bit"
                    },
                    "default": 16,
                    "title": "PCM Bit Depth",
                    "description": "16-bit is a third less bus data and transparent for Opus/AAC; use 24-bit only when PCM is the deliverable."
                },
                "mixLatencyMs": {
                    "type": "number",
                    "default": 200,
                    "minimum": 50,
                    "maximum": 2000,
                    "x-widget": "slider",
                    "x-step": 25,
                    "x-unit": "ms",
                    "title": "Mix Latency",
                    "description": "How long to wait for lagging inputs before emitting; starved inputs get silence."
                }
            }
        },
        "statusSections": [
            {
                "id": "routing",
                "label": "N-1 Routing",
                "fields": [
                    { "key": "pairCount", "label": "Pairs" },
                    { "key": "channels", "label": "Mix Width" },
                    { "key": "connectedInputs", "label": "Connected Inputs" },
                    { "key": "activeOutputs", "label": "Active Outputs" }
                ]
            }
        ],
        "engine": "./engine/N1Mixer302mModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-audio-302m-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
