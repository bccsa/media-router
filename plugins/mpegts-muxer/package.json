{
    "name": "@media-router/plugin-mpegts-muxer",
    "version": "2.0.0",
    "private": true,
    "description": "MPEG-TS muxer — combines any number of MPEG-TS sources (video, audio, subtitles) into a single transport stream",
    "mediaRouter": {
        "pluginId": "mpegts-muxer",
        "displayName": "MPEG-TS Muxer",
        "description": "Combines several muxed/mpegts streams into one — any input takes any stream type (video, audio, KLV/WebVTT or DVB subtitles).",
        "color": "#f59e0b",
        "icon": "git-merge",
        "category": "processing",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "inputs": {
                    "type": "array",
                    "maxItems": 16,
                    "default": [{ "name": "" }],
                    "description": "Each input gets a fixed output PID, so downstream PIDs never change",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string", "default": "", "title": "Name", "description": "Editor label only; not in the transport stream" },
                            "language": {
                                "type": "string",
                                "default": "",
                                "title": "Language",
                                "description": "ISO 639 code written into the PMT. Blank = pass through. Restarts the muxer."
                            },
                            "offsetMs": {
                                "type": "number",
                                "default": 0,
                                "minimum": -2000,
                                "maximum": 2000,
                                "x-step": 10,
                                "x-unit": "ms",
                                "title": "Audio Offset",
                                "description": "Lip-sync offset for this input's audio. Negative advances. Restarts the muxer."
                            },
                            "pid": {
                                "type": "number",
                                "default": 0,
                                "minimum": 0,
                                "maximum": 8190,
                                "x-step": 1,
                                "title": "PID",
                                "description": "Auto-assigned on add; edit to any free value 32–8190. Restarts the muxer."
                            }
                        }
                    },
                    "x-liveUpdatable": true
                },
                "alignment": {
                    "type": "number",
                    "enum": [0, 1, 7],
                    "x-enumLabels": {
                        "0": "Continuous",
                        "1": "One TS packet",
                        "7": "SRT-aligned (1316 B)"
                    },
                    "default": 7,
                    "title": "TS Alignment",
                    "description": "Keep SRT-aligned for SRT/RIST/UDP. Continuous only for v1-style byte-flow receivers."
                },
                "queueLeaky": {
                    "type": "boolean",
                    "default": false,
                    "title": "Leaky Input Queues",
                    "description": "Off: never drop, hold through stalls (contribution). On: shed backlog and resume at the live edge (live).",
                    "x-liveUpdatable": false
                },
                "videoParserBypass": {
                    "type": "boolean",
                    "default": false,
                    "title": "Video Parser Bypass",
                    "description": "Skip the video parser, saving one frame of latency. Only for sources repeating SPS/PPS per keyframe.",
                    "x-liveUpdatable": false
                },
                "queueDepthMs": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 5000,
                    "default": 500,
                    "title": "Queue Depth",
                    "description": "Non-leaky: A/V skew absorbed before back-pressure. Leaky: backlog before shedding.",
                    "x-widget": "slider",
                    "x-step": 50,
                    "x-unit": "ms",
                    "x-liveUpdatable": false
                }
            }
        },
        "statusSections": [
            {
                "id": "udp",
                "label": "UDP Output",
                "fields": [
                    { "key": "host", "label": "Multicast" },
                    { "key": "port", "label": "Port" }
                ]
            },
            {
                "id": "inputs",
                "label": "Active Inputs",
                "fields": [
                    { "key": "connected", "label": "Connected Inputs" },
                    { "key": "streams", "label": "Streams Routed" },
                    { "key": "mode", "label": "Port Mode" }
                ]
            },
            {
                "id": "throughput",
                "label": "Live Throughput",
                "fields": [
                    { "key": "Output Bitrate", "label": "Output Bitrate" },
                    { "key": "Total Bytes", "label": "Total Bytes" }
                ]
            }
        ],
        "engine": "./engine/MpegTsMuxerModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "pnpm run test:py",
        "test:py": "cd py && python3 mux_routing_test.py"
    }
}
