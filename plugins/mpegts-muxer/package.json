{
    "name": "@media-router/plugin-mpegts-muxer",
    "version": "2.0.0",
    "private": true,
    "description": "Multi-program MPEG-TS muxer — combines N video and M audio MPEG-TS sources into a single transport stream",
    "mediaRouter": {
        "pluginId": "mpegts-muxer",
        "displayName": "MPEG-TS Muxer",
        "description": "Combines several muxed/mpegts streams into one — pick any number of video and audio inputs.",
        "color": "#f59e0b",
        "icon": "git-merge",
        "category": "processing",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "videoStreamCount": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 8,
                    "default": 1,
                    "description": "Number of video input streams"
                },
                "audioStreamCount": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 16,
                    "default": 1,
                    "description": "Number of audio input streams"
                },
                "alignment": {
                    "type": "number",
                    "enum": [0, 1, 7],
                    "x-enumLabels": {
                        "0": "Continuous",
                        "1": "One TS packet",
                        "7": "SRT-aligned (1316 B)"
                    },
                    "default": 7,
                    "description": "MPEG-TS muxer alignment — keep at SRT-aligned for SRT/RIST/UDP transport. Use Continuous only for v1-style receivers that derive timing from byte flow (their tsparse mis-estimates bitrate from 1316 B bursts)"
                },
                "bufferMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2000,
                    "default": 50,
                    "description": "Per-pad queue size in milliseconds — lower = lower latency, higher = more jitter tolerance",
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "ms",
                    "x-liveUpdatable": false
                }
            }
        },
        "statusSections": [
            {
                "id": "udp",
                "label": "UDP Output",
                "fields": [
                    { "key": "host", "label": "Multicast" },
                    { "key": "port", "label": "Port" }
                ]
            },
            {
                "id": "inputs",
                "label": "Active Inputs",
                "fields": [
                    { "key": "video", "label": "Video Streams" },
                    { "key": "audio", "label": "Audio Streams" }
                ]
            },
            {
                "id": "throughput",
                "label": "Live Throughput",
                "fields": [
                    { "key": "Output Bitrate", "label": "Output Bitrate" },
                    { "key": "Total Bytes", "label": "Total Bytes" }
                ]
            }
        ],
        "engine": "./engine/MpegTsMuxerModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
