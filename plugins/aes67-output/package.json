{
    "name": "@media-router/plugin-aes67-output",
    "version": "2.0.0",
    "private": true,
    "description": "AES67 output — sends SMPTE-302M off the bus as an AES67 / ST 2110-30 RTP stream, announced over SAP",
    "mediaRouter": {
        "pluginId": "aes67-output",
        "displayName": "AES67 Out",
        "description": "Sends SMPTE-302M audio from the local bus to the network as an AES67 / SMPTE ST 2110-30 RTP stream (L24 or L16, 48 kHz, 1 ms packets, DSCP EF) and announces it over SAP so other devices can find it.",
        "color": "#4f46e5",
        "icon": "arrow-up-from-line",
        "category": "protocol",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-in",
                "direction": "input",
                "streamType": "audio/302m",
                "label": "Audio In (302M)",
                "maxConnections": 1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "address": {
                    "type": "string",
                    "default": "",
                    "description": "Multicast group (usual for AES67) or a single unicast host"
                },
                "port": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 65535,
                    "default": 5004,
                    "title": "RTP Port",
                    "description": "AES67 default 5004"
                },
                "interface": {
                    "type": "string",
                    "default": "",
                    "description": "Empty = system default",
                    "x-deviceType": "network-interface"
                },
                "encoding": {
                    "type": "string",
                    "enum": [
                        "L24",
                        "L16"
                    ],
                    "default": "L24",
                    "description": "L24 is the AES67 default"
                },
                "channels": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 2,
                    "default": 2,
                    "description": "1 or 2. Sources are mixed to stereo."
                },
                "ptimeMs": {
                    "type": "number",
                    "enum": [
                        0.125,
                        0.25,
                        1,
                        4
                    ],
                    "default": 1,
                    "x-unit": "ms",
                    "title": "Packet Time",
                    "description": "1 ms is the AES67 default. 4 ms lowers packet rate; 0.125/0.25 ms lowers latency."
                },
                "payloadType": {
                    "type": "number",
                    "minimum": 96,
                    "maximum": 127,
                    "default": 96,
                    "title": "Payload Type",
                    "description": "RTP payload type to send"
                },
                "mtu": {
                    "type": "number",
                    "minimum": 576,
                    "maximum": 9000,
                    "default": 1452,
                    "title": "MTU",
                    "description": "One packet time must fit, or the module refuses to start"
                },
                "ttl": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 255,
                    "default": 16,
                    "title": "TTL",
                    "description": "Multicast hop limit"
                },
                "dscp": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 63,
                    "default": 46,
                    "title": "DSCP",
                    "description": "46 (EF) is the AES67 recommendation; -1 = unmarked"
                },
                "senderLatencyMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "default": 20,
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "ms",
                    "title": "Sender Latency",
                    "description": "Pacing budget so packets leave evenly. Not the route offset; keep it small."
                },
                "ptpSync": {
                    "type": "boolean",
                    "default": false,
                    "title": "PTP Sync",
                    "description": "Stamp RTP from the PTP epoch. Needs a PTP-disciplined system clock."
                },
                "ptpGmid": {
                    "type": "string",
                    "default": "",
                    "title": "PTP Grandmaster ID",
                    "description": "Announced to receivers once the epoch is locked"
                },
                "ptpDomain": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 127,
                    "default": 0,
                    "title": "PTP Domain",
                    "description": "AES67 default 0"
                },
                "sapEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "SAP Announce",
                    "description": "Announce this stream so other devices can discover it"
                },
                "sapIntervalS": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 300,
                    "default": 30,
                    "x-unit": "s",
                    "title": "SAP Interval",
                    "description": "Seconds between announcements"
                },
                "sessionName": {
                    "type": "string",
                    "default": "",
                    "title": "Session Name",
                    "description": "Shown in other devices' stream pickers. Empty = auto."
                }
            }
        },
        "statusSections": [
            {
                "id": "stream",
                "label": "Stream",
                "fields": [
                    {
                        "key": "destination",
                        "label": "Destination"
                    },
                    {
                        "key": "format",
                        "label": "Format"
                    },
                    {
                        "key": "packetTime",
                        "label": "Packet Time"
                    },
                    {
                        "key": "multicast",
                        "label": "Multicast"
                    }
                ]
            },
            {
                "id": "clock",
                "label": "Clock",
                "fields": [
                    {
                        "key": "epoch",
                        "label": "RTP Epoch"
                    }
                ]
            },
            {
                "id": "stats",
                "label": "Live Stats",
                "fields": [
                    {
                        "key": "bitrate",
                        "label": "Bitrate",
                        "unit": "Mbps"
                    },
                    {
                        "key": "bytesSent",
                        "label": "Bytes Sent"
                    }
                ]
            }
        ],
        "engine": "./engine/Aes67OutputModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-aes67-core": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.5.0"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
