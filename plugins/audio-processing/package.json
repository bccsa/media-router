{
    "name": "@media-router/plugin-audio-processing",
    "version": "2.0.0",
    "private": true,
    "description": "Audio processing on the 302M bus — high-pass, 6-band parametric EQ, dynamics, limiter and sidechain ducking",
    "mediaRouter": {
        "pluginId": "audio-processing",
        "displayName": "Audio Processing",
        "description": "HPF → EQ → dynamics → limiter → ducker on the 302M bus. The sidechain input keys the ducker (or the gate) from any other module's 302M audio.",
        "color": "#f59e0b",
        "icon": "sliders-vertical",
        "category": "processing",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "program-in",
                "direction": "input",
                "streamType": "audio/302m",
                "label": "Program In",
                "maxConnections": -1,
                "acceptsStreamTypes": [
                    "audio/302m"
                ]
            },
            {
                "id": "sidechain-in",
                "direction": "input",
                "streamType": "audio/302m",
                "label": "Sidechain",
                "maxConnections": -1,
                "acceptsStreamTypes": [
                    "audio/302m"
                ]
            },
            {
                "id": "audio-out",
                "direction": "output",
                "streamType": "audio/302m",
                "label": "Audio Out",
                "maxConnections": -1,
                "requiresOrderedApply": true
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": [
                        "none",
                        "ducker",
                        "compressor",
                        "gate",
                        "expander"
                    ],
                    "default": "none",
                    "x-enumLabels": {
                        "none": "Off",
                        "ducker": "Ducker (sidechain-keyed)",
                        "compressor": "Compressor",
                        "gate": "Gate",
                        "expander": "Expander"
                    },
                    "description": "Ducker: sidechain pulls the program down. Compressor, Gate, Expander act on the program itself."
                },
                "transferCurve": {
                    "type": "string",
                    "title": "Transfer Curve",
                    "description": "Input-to-output curve of the stage below, with the live operating point",
                    "x-widget": "graph",
                    "x-graph": {
                        "section": "graphs",
                        "key": "dynamics",
                        "height": 150
                    },
                    "x-showWhen": "mode=compressor,gate,expander"
                },
                "duckEnvelope": {
                    "type": "string",
                    "title": "Duck Envelope",
                    "description": "Program gain through attack, hold and release. Phases are not to scale.",
                    "x-widget": "graph",
                    "x-graph": {
                        "section": "graphs",
                        "key": "duckEnvelope",
                        "height": 150
                    },
                    "x-showWhen": "mode=ducker"
                },
                "threshold": {
                    "type": "number",
                    "minimum": -60,
                    "maximum": 0,
                    "default": -35,
                    "description": "Key level where the dynamics stage engages",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=ducker,compressor,gate,expander",
                    "x-debounceMs": 100
                },
                "duckDepth": {
                    "type": "number",
                    "minimum": -40,
                    "maximum": 0,
                    "default": -12,
                    "title": "Duck Depth",
                    "description": "Level the program drops to while the sidechain is active",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=ducker",
                    "x-debounceMs": 100
                },
                "hold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2000,
                    "default": 250,
                    "description": "Time to stay ducked after the sidechain goes quiet",
                    "x-widget": "slider",
                    "x-step": 10,
                    "x-unit": "ms",
                    "x-live": true,
                    "x-showWhen": "mode=ducker",
                    "x-debounceMs": 100
                },
                "ratio": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 8,
                    "description": "Compression / expansion ratio",
                    "x-widget": "slider",
                    "x-step": 0.5,
                    "x-live": true,
                    "x-showWhen": "mode=compressor,expander",
                    "x-debounceMs": 100
                },
                "attack": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "default": 5,
                    "description": "Attack time",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "ms",
                    "x-live": true,
                    "x-showWhen": "mode=ducker,compressor,gate,expander",
                    "x-debounceMs": 100
                },
                "release": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 2000,
                    "default": 200,
                    "description": "Release time",
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "ms",
                    "x-live": true,
                    "x-showWhen": "mode=ducker,compressor,gate,expander",
                    "x-debounceMs": 100
                },
                "knee": {
                    "type": "number",
                    "minimum": -24,
                    "maximum": 0,
                    "default": -6,
                    "description": "Soft knee width (0 = hard knee)",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=compressor,expander",
                    "x-debounceMs": 100
                },
                "makeupGain": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 24,
                    "default": 0,
                    "title": "Makeup Gain",
                    "description": "Makeup gain after the dynamics stage",
                    "x-widget": "slider",
                    "x-step": 0.5,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=compressor,gate,expander",
                    "x-debounceMs": 100
                },
                "gateDepth": {
                    "type": "number",
                    "minimum": -72,
                    "maximum": 0,
                    "default": -48,
                    "title": "Gate Depth",
                    "description": "Attenuation while the gate is closed",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=gate",
                    "x-debounceMs": 100
                },
                "gateKey": {
                    "type": "string",
                    "enum": [
                        "self",
                        "sidechain"
                    ],
                    "default": "self",
                    "x-enumLabels": {
                        "self": "Program (self)",
                        "sidechain": "Sidechain input"
                    },
                    "title": "Gate Key",
                    "description": "Changing it swaps the DSP element; applies on next restart",
                    "x-showWhen": "mode=gate"
                },
                "hpfEnabled": {
                    "type": "boolean",
                    "default": false,
                    "title": "High-Pass Filter",
                    "description": "Removes rumble and handling noise ahead of the EQ"
                },
                "hpfFreq": {
                    "type": "number",
                    "minimum": 20,
                    "maximum": 500,
                    "default": 80,
                    "title": "High-Pass Cutoff",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "Hz",
                    "x-live": true,
                    "x-showWhen": "hpfEnabled=true",
                    "x-debounceMs": 100
                },
                "eqEnabled": {
                    "type": "boolean",
                    "default": false,
                    "title": "Parametric EQ",
                    "description": "6-band parametric. Bands start Off; pick a type per band."
                },
                "eqBypass": {
                    "type": "boolean",
                    "default": false,
                    "title": "EQ Bypass",
                    "description": "A/B the curve live without rebuilding",
                    "x-live": true,
                    "x-showWhen": "eqEnabled=true"
                },
                "eqInputGain": {
                    "type": "number",
                    "minimum": -24,
                    "maximum": 20,
                    "default": 0,
                    "title": "EQ Input Gain",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 0.5,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "eqEnabled=true",
                    "x-debounceMs": 100
                },
                "eqOutputGain": {
                    "type": "number",
                    "minimum": -24,
                    "maximum": 20,
                    "default": 0,
                    "title": "EQ Output Gain",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 0.5,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "eqEnabled=true",
                    "x-debounceMs": 100
                },
                "eqMode": {
                    "type": "string",
                    "enum": [
                        "rlc-bt",
                        "rlc-mt",
                        "bwc-bt",
                        "bwc-mt",
                        "lrx-bt",
                        "lrx-mt",
                        "apo-dr"
                    ],
                    "default": "rlc-bt",
                    "x-enumLabels": {
                        "rlc-bt": "RLC (BT)",
                        "rlc-mt": "RLC (MT)",
                        "bwc-bt": "BWC (BT)",
                        "bwc-mt": "BWC (MT)",
                        "lrx-bt": "LRX (BT)",
                        "lrx-mt": "LRX (MT)",
                        "apo-dr": "APO (DR)"
                    },
                    "title": "EQ Filter Model",
                    "description": "Applied to all bands. RLC (BT) is the neutral default.",
                    "x-live": true,
                    "x-showWhen": "eqEnabled=true"
                },
                "eqSlope": {
                    "type": "string",
                    "enum": [
                        "x1",
                        "x2",
                        "x3",
                        "x4"
                    ],
                    "default": "x1",
                    "x-enumLabels": {
                        "x1": "x1",
                        "x2": "x2",
                        "x3": "x3",
                        "x4": "x4"
                    },
                    "title": "EQ Slope",
                    "description": "Steeper slopes add latency",
                    "x-live": true,
                    "x-showWhen": "eqEnabled=true"
                },
                "frequencyResponse": {
                    "type": "string",
                    "title": "Frequency Response",
                    "description": "Summed response of all bands and the high-pass filter",
                    "x-widget": "graph",
                    "x-graph": {
                        "section": "graphs",
                        "key": "eq",
                        "height": 150
                    },
                    "x-showWhen": "eqEnabled=true"
                },
