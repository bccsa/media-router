{
    "name": "@media-router/plugin-audio-output",
    "version": "2.0.0",
    "private": true,
    "description": "Audio output \u2014 plays audio to a PipeWire/PulseAudio sink device",
    "mediaRouter": {
        "pluginId": "audio-output",
        "displayName": "Audio Output (Deprecated)",
        "description": "Plays audio to a system audio sink (speakers, headphones, or virtual device). Deprecated — use Audio Output (302M) instead.",
        "color": "#10b981",
        "icon": "volume-2",
        "category": "deprecated",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-in",
                "direction": "input",
                "streamType": "audio/pcm",
                "label": "Audio In",
                "maxConnections": -1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "device": {
                    "type": "string",
                    "default": "",
                    "description": "Output device",
                    "x-deviceType": "audio-sink"
                },
                "sampleRate": {
                    "type": "number",
                    "title": "Sample Rate",
                    "description": "Detected from the device",
                    "x-readOnly": true
                },
                "channels": {
                    "type": "number",
                    "description": "Detected from the device",
                    "x-readOnly": true
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [
                        100,
                        150,
                        200,
                        300,
                        500
                    ],
                    "default": 150,
                    "title": "Volume Range",
                    "description": "Upper end of the volume slider"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "title": "Output Volume",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "Audio Enabled",
                    "description": "",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "title": "Show on LCP",
                    "description": "Show on the Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "title": "LCP Order",
                    "description": "Order on the Local Control Panel, lower = left"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Volume",
                    "description": "Allow volume control on the Local Control Panel"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Mute",
                    "description": "Allow mute control on the Local Control Panel"
                }
            }
        },
        "engine": "./engine/AudioOutputModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
