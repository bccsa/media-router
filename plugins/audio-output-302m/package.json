{
    "name": "@media-router/plugin-audio-output-302m",
    "version": "2.0.0",
    "private": true,
    "description": "Audio output (302M) — N x PCM-302M inputs mixed in GStreamer, played to an explicit device",
    "mediaRouter": {
        "pluginId": "audio-output-302m",
        "displayName": "Audio Output (302M)",
        "description": "Plays SMPTE-302M PCM audio to a physical output device. Multiple sources wired to the input are mixed sample-accurately by timeline (GStreamer audiomixer) — no PipeWire routing fabric involved.",
        "color": "#06b6d4",
        "icon": "volume-2",
        "category": "output",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-in",
                "direction": "input",
                "streamType": "audio/302m",
                "label": "Audio In (302M)",
                "maxConnections": -1,
                "acceptsStreamTypes": ["audio/302m"]
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "device": {
                    "type": "string",
                    "default": "",
                    "description": "Select audio output device",
                    "x-deviceType": "audio-sink"
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [100, 150, 200, 300, 500],
                    "default": 150,
                    "description": "Maximum volume slider range (%)"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "description": "Output volume (%)",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Audio enabled",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "mixLatencyMs": {
                    "type": "number",
                    "default": 200,
                    "minimum": 50,
                    "maximum": 2000,
                    "x-widget": "slider",
                    "x-step": 25,
                    "x-unit": "ms",
                    "description": "Mix latency budget — how long the mixer waits for lagging inputs before emitting; starved inputs are silence-filled."
                },
                "lipSyncMs": {
                    "type": "number",
                    "default": 0,
                    "minimum": -1000,
                    "maximum": 1000,
                    "x-widget": "slider",
                    "x-step": 10,
                    "x-unit": "ms",
                    "x-live": true,
                    "description": "Lip-sync trim for THIS output, added on top of the route's Playout offset (set on the source module). Positive DELAYS audio, negative advances it. Keep it small (tens of ms) — it is for the residual skew of this output's own chain (transcoder hop, DAC); the route offset is what keeps it locked to the video-player. A trim beyond the route offset is clamped: audio cannot play before it arrives. Applies live. No effect while the engine time-sync contract is off."
                },
                "channels": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 2,
                    "description": "Playback channels of the mix (1–8), placed on the device from First channel."
                },
                "firstChannel": {
                    "type": "number",
                    "minimum": 1,
                    "default": 1,
                    "description": "First device output channel to play on (1-based). E.g. 8 channels from 9 drives outputs 9–16."
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show on Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "description": "Display order on LCP (lower = left)"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow volume control on LCP"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow mute control on LCP"
                }
            }
        },
        "engine": "./engine/AudioOutput302mModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-audio-302m-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
