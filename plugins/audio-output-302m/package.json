{
    "name": "@media-router/plugin-audio-output-302m",
    "version": "2.0.0",
    "private": true,
    "description": "Audio output (302M) — N x PCM-302M inputs mixed in GStreamer, played to an explicit device",
    "mediaRouter": {
        "pluginId": "audio-output-302m",
        "displayName": "Audio Output (302M)",
        "description": "Plays SMPTE-302M PCM audio to a physical output device. Multiple sources wired to the input are mixed sample-accurately by timeline (GStreamer audiomixer) — no PipeWire routing fabric involved.",
        "color": "#06b6d4",
        "icon": "volume-2",
        "category": "output",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-in",
                "direction": "input",
                "streamType": "audio/302m",
                "label": "Audio In (302M)",
                "maxConnections": -1,
                "acceptsStreamTypes": ["audio/302m"]
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "device": {
                    "type": "string",
                    "default": "",
                    "description": "Output device",
                    "x-deviceType": "audio-sink"
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [100, 150, 200, 300, 500],
                    "default": 150,
                    "title": "Volume Range",
                    "description": "Upper end of the volume slider"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "title": "Output Volume",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "Audio Enabled",
                    "description": "",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "mixLatencyMs": {
                    "type": "number",
                    "default": 200,
                    "minimum": 50,
                    "maximum": 2000,
                    "x-widget": "slider",
                    "x-step": 25,
                    "x-unit": "ms",
                    "title": "Mix Latency",
                    "description": "How long to wait for lagging inputs before emitting; starved inputs get silence."
                },
                "lipSyncMs": {
                    "type": "number",
                    "default": 0,
                    "minimum": -1000,
                    "maximum": 1000,
                    "x-widget": "slider",
                    "x-step": 10,
                    "x-unit": "ms",
                    "x-live": true,
                    "title": "Lip-Sync Trim",
                    "description": "Trim on top of the route's playout offset. Positive delays audio. Keep to tens of ms."
                },
                "channels": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 2,
                    "description": "1–8, placed on the device from First channel"
                },
                "firstChannel": {
                    "type": "number",
                    "minimum": 1,
                    "default": 1,
                    "title": "First Channel",
                    "description": "1-based. 8 channels from 9 = outputs 9–16."
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "title": "Show on LCP",
                    "description": "Show on the Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "title": "LCP Order",
                    "description": "Order on the Local Control Panel, lower = left"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Volume",
                    "description": "Allow volume control on the Local Control Panel"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Mute",
                    "description": "Allow mute control on the Local Control Panel"
                }
            }
        },
        "engine": "./engine/AudioOutput302mModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-audio-302m-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
