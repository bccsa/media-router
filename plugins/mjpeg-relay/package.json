{
    "name": "@media-router/plugin-mjpeg-relay",
    "version": "2.0.0",
    "private": true,
    "description": "Low-latency MJPEG relay \u2014 sends a camera's MJPG stream over RTP/UDP without transcoding",
    "mediaRouter": {
        "pluginId": "mjpeg-relay",
        "displayName": "MJPEG Relay",
        "description": "Ultra-low-latency monitor feed: relays a V4L2 camera's MJPG frames as RTP/JPEG over UDP, with no decode and no re-encode. Point it at an MJPEG Monitor module (or any RTP/JPEG receiver). High bitrate (~50 Mbps at 1080p50) \u2014 LAN only. Runs outside the MPEG-TS bus, so it has no ports; pair the destination by hand.",
        "color": "#f59e0b",
        "icon": "bolt",
        "category": "protocol",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "device": {
                    "type": "string",
                    "default": "",
                    "description": "V4L2 capture device (must offer MJPG at the selected mode)",
                    "x-deviceType": "video"
                },
                "resolution": {
                    "type": "string",
                    "enum": [
                        "1920x1080",
                        "1280x720"
                    ],
                    "default": "1920x1080",
                    "description": "Capture resolution \u2014 must be a mode the device offers as MJPG"
                },
                "framerate": {
                    "type": "number",
                    "enum": [
                        25,
                        30,
                        50,
                        60
                    ],
                    "default": 50,
                    "description": "Capture framerate \u2014 higher is lower latency; must be offered by the device at this resolution"
                },
                "host": {
                    "type": "string",
                    "default": "",
                    "description": "Destination host (unicast IP of the monitor box)"
                },
                "port": {
                    "type": "number",
                    "minimum": 1024,
                    "maximum": 65535,
                    "default": 5008,
                    "description": "Destination UDP port"
                }
            }
        },
        "statusSections": [
            {
                "id": "relay",
                "label": "Relay",
                "fields": [
                    {
                        "key": "mode",
                        "label": "Mode"
                    },
                    {
                        "key": "destination",
                        "label": "Destination"
                    }
                ]
            }
        ],
        "engine": "engine/MjpegRelayModule.ts"
    },
    "main": "dist/MjpegRelayModule.js",
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
