{
    "name": "@media-router/plugin-aes67-input",
    "version": "2.0.0",
    "private": true,
    "description": "AES67 input — receives an AES67 / ST 2110-30 RTP audio stream and publishes it on the bus as SMPTE-302M",
    "mediaRouter": {
        "pluginId": "aes67-input",
        "displayName": "AES67 In",
        "description": "Receives an AES67 / SMPTE ST 2110-30 audio stream (L24 or L16, 48 kHz, multicast or unicast) and publishes it on the local bus as SMPTE-302M. Streams announced over SAP can be picked from a list instead of typed in.",
        "color": "#6366f1",
        "icon": "arrow-down-to-line",
        "category": "protocol",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-out",
                "direction": "output",
                "streamType": "audio/302m",
                "label": "Audio Out (302M)",
                "maxConnections": -1,
                "requiresOrderedApply": true
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "discoveredStream": {
                    "type": "string",
                    "default": "",
                    "title": "Discovered Stream",
                    "description": "Stream found via SAP. Picking one fills in the fields below.",
                    "x-deviceType": "aes67-stream"
                },
                "address": {
                    "type": "string",
                    "default": "",
                    "description": "Multicast group or local unicast address. Ignored when a discovered stream is selected."
                },
                "port": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 65535,
                    "default": 5004,
                    "title": "RTP Port",
                    "description": "AES67 default 5004"
                },
                "interface": {
                    "type": "string",
                    "default": "",
                    "description": "Empty = system default",
                    "x-deviceType": "network-interface"
                },
                "encoding": {
                    "type": "string",
                    "enum": [
                        "L24",
                        "L16"
                    ],
                    "default": "L24",
                    "description": "L24 is the AES67 default"
                },
                "channels": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 2,
                    "description": "The bus carries stereo 302M; more than 2 are downmixed"
                },
                "pcmBitDepth": {
                    "type": "number",
                    "enum": [16, 24],
                    "x-enumLabels": {
                        "16": "16-bit (lower CPU)",
                        "24": "24-bit"
                    },
                    "default": 16,
                    "title": "PCM Bit Depth",
                    "description": "16-bit is a third less bus data and transparent for Opus/AAC; use 24-bit only when PCM is the deliverable."
                },
                "payloadType": {
                    "type": "number",
                    "minimum": 96,
                    "maximum": 127,
                    "default": 96,
                    "title": "Payload Type",
                    "description": "RTP payload type the sender uses"
                },
                "jitterBufferMs": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 500,
                    "default": 20,
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "ms",
                    "title": "Jitter Buffer",
                    "description": "Default 20 ms = 20 packet times. Raise on congested or wireless paths."
                },
                "ptpSync": {
                    "type": "boolean",
                    "default": false,
                    "title": "PTP Sync",
                    "description": "Schedule on the sender's PTP clock. Needs a grandmaster and its ID below, or the stream goes silent."
                },
                "ptpGmid": {
                    "type": "string",
                    "default": "",
                    "title": "PTP Grandmaster ID",
                    "description": "Required for PTP sync, e.g. 00-1D-C1-FF-FE-50-30-EE"
                },
                "ptpDomain": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 127,
                    "default": 0,
                    "title": "PTP Domain",
                    "description": "AES67 default 0"
                },
                "playoutOffsetMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000,
                    "x-unit": "ms",
                    "x-live": true,
                    "title": "Playout Offset",
                    "description": "Route latency budget: how far behind the house clock players present. Empty = engine default (60 ms)."
                }
            }
        },
        "statusSections": [
            {
                "id": "stream",
                "label": "Stream",
                "fields": [
                    {
                        "key": "source",
                        "label": "Source"
                    },
                    {
                        "key": "format",
                        "label": "Format"
                    },
                    {
                        "key": "payloadType",
                        "label": "Payload Type"
                    },
                    {
                        "key": "multicast",
                        "label": "Multicast"
                    }
                ]
            },
            {
                "id": "clock",
                "label": "Clock",
                "fields": [
                    {
                        "key": "ptpSync",
                        "label": "PTP Sync"
                    }
                ]
            },
            {
                "id": "stats",
                "label": "Live Stats",
                "fields": [
                    {
                        "key": "bitrate",
                        "label": "Bitrate",
                        "unit": "Mbps"
                    },
                    {
                        "key": "bytesReceived",
                        "label": "Bytes Received"
                    }
                ]
            },
            {
                "id": "discovery",
                "label": "SAP Discovery",
                "fields": [
                    {
                        "key": "discovered",
                        "label": "Streams Seen"
                    }
                ]
            }
        ],
        "engine": "./engine/Aes67InputModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-audio-302m-core": "workspace:*",
        "@media-router/plugin-aes67-core": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.5.0"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
