{
    "name": "@media-router/plugin-mpegts-demuxer",
    "version": "2.0.0",
    "private": true,
    "description": "MPEG-TS demuxer — splits a multi-program transport stream into separate video/audio outputs",
    "mediaRouter": {
        "pluginId": "mpegts-demuxer",
        "displayName": "MPEG-TS Demuxer",
        "description": "Receives one muxed/mpegts stream and splits it into N video and M audio outputs, each on its own multicast group.",
        "color": "#f59e0b",
        "icon": "git-fork",
        "category": "processing",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "bufferMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5000,
                    "default": 50,
                    "description": "Per-pad queue size in milliseconds — lower = lower latency, higher = more jitter tolerance",
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "ms",
                    "x-liveUpdatable": false
                },
                "outputBufferMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5000,
                    "default": 0,
                    "description": "Output smoothing buffer (ms). 0 = OFF (lowest latency — keep for SRT/RIST live sources). Raise to absorb bursty sources (e.g. an HLS player that emits at segment boundaries): a non-leaky queue holds up to this much per output and re-feeds it steadily instead of dropping packets mid-frame. Adds this much latency; pick the largest delay you can tolerate for HLS, leave at 0 for low-latency live.",
                    "x-widget": "slider",
                    "x-step": 50,
                    "x-unit": "ms",
                    "x-liveUpdatable": false
                }
            }
        },
        "statusSections": [
            {
                "id": "input",
                "label": "Input",
                "fields": [
                    { "key": "host", "label": "Multicast" },
                    { "key": "port", "label": "Port" }
                ]
            },
            {
                "id": "outputs",
                "label": "Outputs",
                "fields": [
                    { "key": "video", "label": "Video Streams" },
                    { "key": "audio", "label": "Audio Streams" }
                ]
            },
            {
                "id": "streams",
                "label": "Detected Streams",
                "fields": [
                    { "key": "detected", "label": "Count" },
                    { "key": "stale", "label": "Stale" }
                ]
            }
        ],
        "engine": "./engine/MpegTsDemuxerModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
