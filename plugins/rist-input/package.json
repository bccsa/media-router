{
    "name": "@media-router/plugin-rist-input",
    "version": "2.0.0",
    "private": true,
    "description": "RIST input — receives MPEG-TS stream over RIST protocol with bonding support",
    "mediaRouter": {
        "pluginId": "rist-input",
        "displayName": "RIST Input",
        "description": "Receives MPEG-TS stream over RIST (Reliable Internet Stream Transport). Supports multi-link bonding with per-link weight, cname, and encryption.",
        "color": "#06b6d4",
        "icon": "radio",
        "category": "protocol",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "mpegts-out",
                "direction": "output",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS Out",
                "maxConnections": -1,
                "requiresOrderedApply": true
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "links": {
                    "type": "array",
                    "default": [
                        {
                            "mode": "listener",
                            "address": "0.0.0.0",
                            "port": 5004,
                            "weight": 50,
                            "cname": "link1"
                        }
                    ],
                    "title": "Links",
                    "description": "Several links bond for load balancing or backup",
                    "items": {
                        "type": "object",
                        "properties": {
                            "mode": {
                                "type": "string",
                                "enum": [
                                    "listener",
                                    "caller"
                                ],
                                "default": "listener",
                                "title": "Mode",
                                "description": ""
                            },
                            "address": {
                                "type": "string",
                                "default": "0.0.0.0",
                                "title": "Address",
                                "description": ""
                            },
                            "port": {
                                "type": "number",
                                "default": 5004,
                                "title": "Port",
                                "description": ""
                            },
                            "weight": {
                                "type": "number",
                                "default": 50,
                                "title": "Weight",
                                "description": "0 = backup, 1–100 = load balance"
                            },
                            "cname": {
                                "type": "string",
                                "default": "",
                                "title": "CNAME",
                                "description": "Link identifier"
                            }
                        }
                    }
                },
                "profile": {
                    "type": "number",
                    "enum": [
                        0,
                        1,
                        2
                    ],
                    "default": 1,
                    "description": "0 = simple, 1 = main, 2 = advanced"
                },
                "buffer": {
                    "type": "number",
                    "default": 1000,
                    "title": "Retransmission Buffer",
                    "description": "ms"
                },
                "sessionTimeout": {
                    "type": "number",
                    "default": 0,
                    "x-unit": "ms",
                    "x-advanced": true,
                    "title": "Session Timeout",
                    "description": "No-data time before the flow is dropped and reconnected. 0 = 2000. ~10000 rides out brief blackouts."
                },
                "secret": {
                    "type": "string",
                    "default": "",
                    "title": "Passphrase",
                    "description": "PSK passphrase"
                },
                "encryptionType": {
                    "type": "number",
                    "enum": [
                        0,
                        128,
                        256
                    ],
                    "default": 0,
                    "title": "Encryption",
                    "description": "0 = none, 128 = AES-128, 256 = AES-256"
                },
                "statsInterval": {
                    "type": "number",
                    "default": 1000,
                    "title": "Stats Interval",
                    "description": "ms"
                },
                "playoutOffsetMs": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10000,
                    "x-unit": "ms",
                    "x-live": true,
                    "title": "Playout Offset",
                    "description": "Route latency budget: how far behind the house clock players present. Empty = engine default (60 ms)."
                }
            }
        },
        "statusSections": [
            {
                "id": "connection",
                "label": "Connection",
                "fields": [
                    {
                        "key": "profile",
                        "label": "Profile"
                    },
                    {
                        "key": "linkCount",
                        "label": "Links"
                    },
                    {
                        "key": "encrypted",
                        "label": "Encrypted"
                    }
                ]
            },
            {
                "id": "stats",
                "label": "Live Stats",
                "fields": [
                    {
                        "key": "received",
                        "label": "Received"
                    },
                    {
                        "key": "dropped",
                        "label": "Dropped"
                    },
                    {
                        "key": "recovered",
                        "label": "Recovered"
                    },
                    {
                        "key": "loss",
                        "label": "Loss (recovered)",
                        "unit": "%"
                    },
                    {
                        "key": "lost",
                        "label": "Permanently Lost"
                    },
                    {
                        "key": "rtt",
                        "label": "RTX RTT",
                        "unit": "ms"
                    }
                ]
            }
        ],
        "engine": "./engine/RistInputModule.ts",
        "faceWidgets": [
            {
                "id": "status-line",
                "type": "status-line",
                "section": "stats",
                "template": "Q: {quality} | Recv: {received}"
            }
        ]
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-rist-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
