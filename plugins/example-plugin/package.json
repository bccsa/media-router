{
    "name": "@media-router/plugin-example",
    "version": "2.0.0",
    "private": true,
    "description": "Example plugin — template for building Media Router plugins",
    "mediaRouter": {
        "pluginId": "example",
        "displayName": "Example Plugin",
        "description": "A minimal plugin template for development reference",
        "category": "utility",
        "architectures": ["arm64", "x86_64"],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "description": "Example config parameter",
                    "default": "hello"
                }
            }
        },
        "engine": "./engine/ExampleModule.ts"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
