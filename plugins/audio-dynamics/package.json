{
    "name": "@media-router/plugin-audio-dynamics",
    "version": "2.0.0",
    "private": true,
    "description": "Audio dynamics \u2014 compressor, ducker, and gate with external sidechain",
    "mediaRouter": {
        "pluginId": "audio-dynamics",
        "displayName": "Audio Dynamics (Deprecated)",
        "description": "Compressor / ducker / gate. The sidechain input keys the processing from any other module's audio output (e.g. voice ducks music). Deprecated — 302M replacement (Audio Processing) pending.",
        "color": "#f59e0b",
        "icon": "activity",
        "category": "deprecated",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "program-in",
                "direction": "input",
                "streamType": "audio/pcm",
                "label": "Program In",
                "maxConnections": -1
            },
            {
                "id": "sidechain-in",
                "direction": "input",
                "streamType": "audio/pcm",
                "label": "Sidechain",
                "maxConnections": -1
            },
            {
                "id": "audio-out",
                "direction": "output",
                "streamType": "audio/pcm",
                "label": "Audio Out",
                "maxConnections": -1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": [
                        "ducker",
                        "compressor",
                        "gate"
                    ],
                    "default": "ducker",
                    "x-enumLabels": {
                        "ducker": "Ducker (sidechain-keyed)",
                        "compressor": "Compressor",
                        "gate": "Gate"
                    },
                    "description": "Ducker: sidechain input compresses the program (voice ducks music). Compressor: program compresses itself. Gate: attenuate below threshold."
                },
                "threshold": {
                    "type": "number",
                    "minimum": -60,
                    "maximum": 0,
                    "default": -35,
                    "description": "Key level where processing engages",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-debounceMs": 100
                },
                "duckDepth": {
                    "type": "number",
                    "minimum": -40,
                    "maximum": 0,
                    "default": -12,
                    "description": "Exact level the program drops to while the sidechain is active (relative to normal)",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=ducker",
                    "x-debounceMs": 100
                },
                "hold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2000,
                    "default": 250,
                    "description": "How long to stay ducked after the sidechain goes quiet, before releasing",
                    "x-widget": "slider",
                    "x-step": 10,
                    "x-unit": "ms",
                    "x-live": true,
                    "x-showWhen": "mode=ducker",
                    "x-debounceMs": 100
                },
                "ratio": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 8,
                    "description": "Compression ratio",
                    "x-widget": "slider",
                    "x-step": 0.5,
                    "x-live": true,
                    "x-showWhen": "mode=compressor",
                    "x-debounceMs": 100
                },
                "attack": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "default": 5,
                    "description": "Attack time",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "ms",
                    "x-live": true,
                    "x-debounceMs": 100
                },
                "release": {
                    "type": "number",
                    "minimum": 5,
                    "maximum": 2000,
                    "default": 200,
                    "description": "Release time",
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "ms",
                    "x-live": true,
                    "x-debounceMs": 100
                },
                "knee": {
                    "type": "number",
                    "minimum": -24,
                    "maximum": 0,
                    "default": -6,
                    "description": "Soft knee width (0 = hard knee)",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=compressor",
                    "x-debounceMs": 100
                },
                "makeupGain": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 24,
                    "default": 0,
                    "description": "Makeup gain after processing",
                    "x-widget": "slider",
                    "x-step": 0.5,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=compressor,gate",
                    "x-debounceMs": 100
                },
                "gateDepth": {
                    "type": "number",
                    "minimum": -72,
                    "maximum": 0,
                    "default": -48,
                    "description": "Attenuation while the gate is closed",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-unit": "dB",
                    "x-live": true,
                    "x-showWhen": "mode=gate",
                    "x-debounceMs": 100
                },
                "gateKey": {
                    "type": "string",
                    "enum": [
                        "self",
                        "sidechain"
                    ],
                    "default": "self",
                    "x-enumLabels": {
                        "self": "Program (self)",
                        "sidechain": "Sidechain input"
                    },
                    "description": "Signal that opens the gate",
                    "x-live": true,
                    "x-showWhen": "mode=gate"
                }
            }
        },
        "statusSections": [
            {
                "id": "dynamics",
                "label": "Dynamics",
                "fields": [
                    {
                        "key": "gainReduction",
                        "label": "Gain Reduction"
                    },
                    {
                        "key": "keyLevel",
                        "label": "Key Level"
                    },
                    {
                        "key": "element",
                        "label": "DSP Element"
                    }
                ]
            }
        ],
        "engine": "./engine/AudioDynamicsModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
