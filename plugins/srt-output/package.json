{
    "name": "@media-router/plugin-srt-output",
    "version": "2.0.0",
    "private": true,
    "description": "SRT output \u2014 sends MPEG-TS stream over SRT protocol",
    "mediaRouter": {
        "pluginId": "srt-output",
        "displayName": "SRT Output",
        "description": "Sends MPEG-TS stream over SRT (Secure Reliable Transport). Supports listener and caller modes with optional encryption.",
        "color": "#f97316",
        "icon": "arrow-up-from-line",
        "category": "protocol",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "mpegts-in",
                "direction": "input",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS In",
                "maxConnections": 1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "host": {
                    "type": "string",
                    "default": "0.0.0.0",
                    "description": "Listen/connect address"
                },
                "port": {
                    "type": "number",
                    "default": 9000,
                    "description": "SRT port"
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "listener",
                        "caller",
                        "rendezvous"
                    ],
                    "default": "caller",
                    "description": "Connection mode"
                },
                "latency": {
                    "type": "number",
                    "default": 125,
                    "description": "SRT latency (ms)"
                },
                "streamId": {
                    "type": "string",
                    "default": "",
                    "description": "Stream ID for access control"
                },
                "passphrase": {
                    "type": "string",
                    "default": "",
                    "description": "Encryption passphrase"
                },
                "pbKeyLen": {
                    "type": "number",
                    "enum": [
                        0,
                        16,
                        24,
                        32
                    ],
                    "default": 0,
                    "description": "Encryption key length (0 = none)"
                }
            }
        },
        "statusSections": [
            {
                "id": "connection",
                "label": "Connection",
                "fields": [
                    {
                        "key": "mode",
                        "label": "Mode"
                    },
                    {
                        "key": "host",
                        "label": "Host"
                    },
                    {
                        "key": "port",
                        "label": "Port"
                    },
                    {
                        "key": "encrypted",
                        "label": "Encrypted"
                    }
                ]
            },
            {
                "id": "stats",
                "label": "Live Stats",
                "fields": [
                    {
                        "key": "bitrate",
                        "label": "Bitrate",
                        "unit": "Mbps"
                    },
                    {
                        "key": "rtt",
                        "label": "RTT",
                        "unit": "ms"
                    },
                    {
                        "key": "packetLoss",
                        "label": "Packet Loss"
                    },
                    {
                        "key": "bytesSent",
                        "label": "Bytes Sent"
                    },
                    {
                        "key": "callers",
                        "label": "Callers"
                    }
                ]
            }
        ],
        "engine": "./engine/SrtOutputModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
