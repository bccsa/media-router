{
    "name": "@media-router/plugin-audio-transcoder",
    "version": "2.0.0",
    "private": true,
    "description": "Audio transcoder — decode once, encode to N renditions (Opus / AAC / PCM 302M), timeline-preserving",
    "mediaRouter": {
        "pluginId": "audio-transcoder",
        "displayName": "Audio Transcoder",
        "description": "Decodes one audio source (any TS-family stream — Opus, AAC, MP2, AC-3, or 302M PCM; the codec is probed) once and re-encodes it into several renditions — Opus, AAC, or PCM 302M — each on its own output port. Preserves the source timeline end-to-end (no PipeWire re-stamping), so downstream muxers keep A/V sync. To sum several sources first, wire them through an Audio Mixer.",
        "color": "#06b6d4",
        "icon": "audio-waveform",
        "category": "codec",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "renditions": {
                    "type": "array",
                    "maxItems": 8,
                    "default": [
                        { "name": "PCM 302M", "codec": "pcm" }
                    ],
                    "description": "Each rendition is an output port. Opus/AAC for distribution, PCM 302M for lossless audio.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string", "default": "", "title": "Name", "description": "Optional label" },
                            "codec": {
                                "type": "string",
                                "enum": ["opus", "aac", "pcm"],
                                "x-enumLabels": {
                                    "opus": "Opus",
                                    "aac": "AAC",
                                    "pcm": "PCM 302M (lossless)"
                                },
                                "default": "opus",
                                "title": "Codec",
                                "description": "PCM 302M is fixed-rate (~2.3 Mbps stereo) and lossless"
                            },
                            "bitrate": {
                                "type": "number",
                                "minimum": 6,
                                "maximum": 510,
                                "default": 128,
                                "x-unit": "kbps",
                                "x-showWhen": "codec=opus,aac",
                                "title": "Bitrate",
                                "description": "Total for all channels, not per channel (Opus 6-510, AAC 32-320); 48-64 is enough for speech.",
                                "x-maxBy": { "field": "codec", "map": { "opus": 510, "aac": 320 } }
                            },
                            "frameSize": {
                                "type": "number",
                                "enum": [2.5, 5, 10, 20, 40, 60],
                                "default": 20,
                                "x-unit": "ms",
                                "x-showWhen": "codec=opus",
                                "x-advanced": true,
                                "title": "Frame Size",
                                "description": "Smaller = lower latency, more overhead"
                            },
                            "inbandFec": {
                                "type": "boolean",
                                "default": false,
                                "x-showWhen": "codec=opus",
                                "x-advanced": true,
                                "title": "In-band FEC",
                                "description": "Opus forward error correction"
                            },
                            "packetLoss": {
                                "type": "number",
                                "enum": [0, 5, 10, 15, 20, 25, 30, 50],
                                "default": 10,
                                "x-unit": "%",
                                "x-showWhen": "codec=opus",
                                "x-advanced": true,
                                "title": "Expected Packet Loss",
                                "description": "Drives FEC strength"
                            },
                            "audioType": {
                                "type": "number",
                                "enum": [0, 2048, 2049, 2051],
                                "x-enumLabels": {
                                    "0": "Auto",
                                    "2048": "Generic",
                                    "2049": "Voice",
                                    "2051": "Restricted low delay"
                                },
                                "default": 0,
                                "x-showWhen": "codec=opus",
                                "x-advanced": true,
                                "title": "Audio Type",
                                "description": "Auto picks by frame size"
                            }
                        }
                    }
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "title": "Volume",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "Audio Enabled",
                    "description": "",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "channels": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 2,
                    "default": 2,
                    "description": "PCM 302M renditions are stereo"
                },
                "sampleRate": {
                    "type": "number",
                    "enum": [48000],
                    "default": 48000,
                    "x-readOnly": true,
                    "title": "Sample Rate",
                    "description": "48 kHz (SMPTE 302M)"
                },
                "bufferMs": {
                    "type": "number",
                    "default": 75,
                    "minimum": 50,
                    "maximum": 5000,
                    "x-widget": "slider",
                    "x-step": 25,
                    "x-unit": "ms",
                    "title": "Buffer",
                    "description": "Keep low; its fill adds latency at downstream muxers. Raise for HLS or bursty sources."
                },
                "preserveSourceTimeline": {
                    "type": "boolean",
                    "default": true,
                    "x-advanced": true,
                    "title": "Preserve Source Timeline",
                    "description": "Keep source timestamps so muxers align audio with video and lip-sync survives restarts."
                },
                "pcmBitDepth": {
                    "type": "number",
                    "enum": [16, 24],
                    "x-enumLabels": {
                        "16": "16-bit (lower CPU)",
                        "24": "24-bit"
                    },
                    "default": 16,
                    "title": "PCM Bit Depth",
                    "description": "16-bit is a third less bus data and transparent for Opus/AAC; use 24-bit only when PCM is the deliverable."
                },
                "tsAlignment": {
                    "type": "number",
                    "enum": [0, 1, 7],
                    "x-enumLabels": {
                        "0": "Continuous",
                        "1": "One TS packet",
                        "7": "SRT-aligned (1316 B)"
                    },
                    "default": 7,
                    "title": "TS Alignment",
                    "description": "Keep SRT-aligned for SRT/RIST/UDP"
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "title": "Show on LCP",
                    "description": "Show on the Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "title": "LCP Order",
                    "description": "Order on the Local Control Panel, lower = left"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Volume",
                    "description": "Allow volume control on the Local Control Panel"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Mute",
                    "description": "Allow mute control on the Local Control Panel"
                }
            }
        },
        "engine": "./engine/AudioTranscoderModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-audio-302m-core": "workspace:*",
        "@media-router/plugin-mpegts-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
