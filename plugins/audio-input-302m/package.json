{
    "name": "@media-router/plugin-audio-input-302m",
    "version": "2.0.0",
    "private": true,
    "description": "Audio input (302M) — physical capture device to PCM-302M output",
    "mediaRouter": {
        "pluginId": "audio-input-302m",
        "displayName": "Audio Input (302M)",
        "description": "Captures audio from a physical input device and emits it as SMPTE-302M PCM-in-TS — the timeline-defining ingest point for live analog/digital sources.",
        "color": "#06b6d4",
        "icon": "mic",
        "category": "input",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-out",
                "direction": "output",
                "streamType": "audio/302m",
                "label": "Audio Out (302M)",
                "maxConnections": -1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "device": {
                    "type": "string",
                    "default": "",
                    "description": "Capture device",
                    "x-deviceType": "audio-source"
                },
                "channels": {
                    "type": "number",
                    "enum": [2, 4, 6, 8],
                    "default": 2,
                    "description": "302M carries at most 8; add another input for more"
                },
                "firstChannel": {
                    "type": "number",
                    "minimum": 1,
                    "default": 1,
                    "title": "First Channel",
                    "description": "1-based. 8 channels from 9 = desk inputs 9–16."
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [100, 150, 200, 300, 500],
                    "default": 150,
                    "title": "Volume Range",
                    "description": "Upper end of the volume slider"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "title": "Input Volume",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "Audio Enabled",
                    "description": "",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "srcBufferMs": {
                    "type": "number",
                    "default": 60,
                    "minimum": 40,
                    "maximum": 85,
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "ms",
                    "title": "Capture Buffer",
                    "description": "Capture quantum. 40–60 on smooth systems; raise on xruns. Above 85 ms is clamped."
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "title": "Show on LCP",
                    "description": "Show on the Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "title": "LCP Order",
                    "description": "Order on the Local Control Panel, lower = left"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Volume",
                    "description": "Allow volume control on the Local Control Panel"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Mute",
                    "description": "Allow mute control on the Local Control Panel"
                }
            }
        },
        "engine": "./engine/AudioInput302mModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-audio-302m-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
