{
    "name": "@media-router/plugin-audio-input-302m",
    "version": "2.0.0",
    "private": true,
    "description": "Audio input (302M) — physical capture device to PCM-302M output",
    "mediaRouter": {
        "pluginId": "audio-input-302m",
        "displayName": "Audio Input (302M)",
        "description": "Captures audio from a physical input device and emits it as SMPTE-302M PCM-in-TS — the timeline-defining ingest point for live analog/digital sources.",
        "color": "#06b6d4",
        "icon": "mic",
        "category": "input",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-out",
                "direction": "output",
                "streamType": "audio/302m",
                "label": "Audio Out (302M)",
                "maxConnections": -1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "device": {
                    "type": "string",
                    "default": "",
                    "description": "Select audio input device",
                    "x-deviceType": "audio-source"
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [100, 150, 200, 300, 500],
                    "default": 150,
                    "description": "Maximum volume slider range (%)"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "description": "Input volume (%)",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Audio enabled",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "srcBufferMs": {
                    "type": "number",
                    "default": 60,
                    "minimum": 40,
                    "maximum": 1000,
                    "x-widget": "slider",
                    "x-step": 10,
                    "x-unit": "ms",
                    "description": "Capture ring buffer — part of the source's standing latency; 40-60 validated on smooth systems, raise if capture xruns appear."
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show on Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "description": "Display order on LCP (lower = left)"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow volume control on LCP"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow mute control on LCP"
                }
            }
        },
        "engine": "./engine/AudioInput302mModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-audio-302m-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
