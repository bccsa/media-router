{
    "name": "@media-router/plugin-audio-encoder",
    "version": "2.0.0",
    "private": true,
    "description": "Audio encoder — PCM input to MPEG-TS output (Opus/AAC/PCM)",
    "mediaRouter": {
        "pluginId": "audio-encoder",
        "displayName": "Audio Encoder",
        "description": "Encodes PCM audio into MPEG-TS container with selectable codec (Opus, AAC)",
        "color": "#f59e0b",
        "icon": "upload",
        "category": "codec",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-in",
                "direction": "input",
                "streamType": "audio/pcm",
                "label": "Audio In",
                "maxConnections": -1
            },
            {
                "id": "mpegts-out",
                "direction": "output",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS Out",
                "maxConnections": -1,
                "requiresOrderedApply": true
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "codec": {
                    "type": "string",
                    "enum": [
                        "opus",
                        "aac"
                    ],
                    "default": "opus",
                    "description": "Audio codec"
                },
                "bitrate": {
                    "type": "number",
                    "default": 128,
                    "description": "Bitrate in kbps",
                    "x-liveUpdatable": true,
                    "x-enumBy": {
                        "field": "codec",
                        "map": {
                            "opus": [
                                32,
                                64,
                                96,
                                128,
                                192,
                                256,
                                320,
                                510
                            ],
                            "aac": [
                                32,
                                64,
                                96,
                                128,
                                160,
                                192,
                                256,
                                320
                            ]
                        }
                    }
                },
                "frameSize": {
                    "type": "number",
                    "enum": [
                        2.5,
                        5,
                        10,
                        20,
                        40,
                        60
                    ],
                    "default": 20,
                    "description": "Opus frame size in ms (lower = less latency, more CPU/bandwidth)",
                    "x-showWhen": "codec=opus"
                },
                "audioType": {
                    "type": "number",
                    "enum": [
                        0,
                        2048,
                        2049,
                        2051
                    ],
                    "x-enumLabels": {
                        "0": "Auto (Restricted Low-delay if frame size ≤ 5 ms, else Generic)",
                        "2048": "Generic",
                        "2049": "Voice",
                        "2051": "Restricted Low-delay"
                    },
                    "default": 0,
                    "description": "Opus audio type",
                    "x-showWhen": "codec=opus"
                },
                "inbandFec": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable in-band forward error correction. Typically only needed when distributing audio without a reliable container (e.g. sending feeds to MediaMTX for WebRTC); leave off for RIST/SRT.",
                    "x-showWhen": "codec=opus"
                },
                "packetLoss": {
                    "type": "number",
                    "enum": [
                        0,
                        5,
                        10,
                        15,
                        20,
                        25,
                        30,
                        50
                    ],
                    "default": 10,
                    "description": "Expected packet loss % — encoder adds more redundancy at higher values",
                    "x-showWhen": "codec=opus"
                },
                "sampleRate": {
                    "type": "number",
                    "enum": [
                        44100,
                        48000
                    ],
                    "default": 48000,
                    "description": "Audio sample rate in Hz"
                },
                "channels": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 2,
                    "description": "Number of audio channels"
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [
                        100,
                        150,
                        200,
                        300,
                        500
                    ],
                    "default": 150,
                    "description": "Maximum volume slider range (%)"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "description": "Volume (%)",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Audio enabled",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show on Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "description": "Display order on LCP (lower = left)"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow volume control on LCP"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow mute control on LCP"
                }
            }
        },
        "statusSections": [
            {
                "id": "udp",
                "label": "UDP Output",
                "fields": [
                    {
                        "key": "host",
                        "label": "Multicast"
                    },
                    {
                        "key": "port",
                        "label": "Port"
                    }
                ]
            },
            {
                "id": "encoder",
                "label": "Encoder",
                "fields": [
                    {
                        "key": "codec",
                        "label": "Codec"
                    },
                    {
                        "key": "bitrate",
                        "label": "Bitrate",
                        "unit": "kbps"
                    },
                    {
                        "key": "sampleRate",
                        "label": "Sample Rate",
                        "unit": "Hz"
                    },
                    {
                        "key": "channels",
                        "label": "Channels"
                    }
                ]
            },
            {
                "id": "throughput",
                "label": "Live Throughput",
                "fields": [
                    {
                        "key": "Output Bitrate",
                        "label": "Output Bitrate"
                    },
                    {
                        "key": "Total Bytes",
                        "label": "Total Bytes"
                    }
                ]
            }
        ],
        "engine": "./engine/AudioEncoderModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
