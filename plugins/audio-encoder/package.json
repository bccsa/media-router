{
    "name": "@media-router/plugin-audio-encoder",
    "version": "2.0.0",
    "private": true,
    "description": "Audio encoder — PCM input to MPEG-TS output (Opus/AAC/PCM)",
    "mediaRouter": {
        "pluginId": "audio-encoder",
        "displayName": "Audio Encoder (Deprecated)",
        "description": "Encodes PCM audio into MPEG-TS container with selectable codec (Opus, AAC). Deprecated — use Audio Transcoder instead.",
        "color": "#f59e0b",
        "icon": "upload",
        "category": "deprecated",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-in",
                "direction": "input",
                "streamType": "audio/pcm",
                "label": "Audio In",
                "maxConnections": -1
            },
            {
                "id": "mpegts-out",
                "direction": "output",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS Out",
                "maxConnections": -1,
                "requiresOrderedApply": true
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "codec": {
                    "type": "string",
                    "enum": [
                        "opus",
                        "aac"
                    ],
                    "default": "opus",
                    "description": "Audio codec"
                },
                "bitrate": {
                    "type": "number",
                    "default": 128,
                    "minimum": 6,
                    "maximum": 510,
                    "description": "Any bitrate in kbps (Opus 6-510, AAC 32-320); 48-64 is enough for speech.",
                    "x-liveUpdatable": true,
                    "x-debounceMs": 300,
                    "x-maxBy": {
                        "field": "codec",
                        "map": {
                            "opus": 510,
                            "aac": 320
                        }
                    }
                },
                "frameSize": {
                    "type": "number",
                    "enum": [
                        2.5,
                        5,
                        10,
                        20,
                        40,
                        60
                    ],
                    "default": 20,
                    "title": "Frame Size",
                    "description": "Lower = less latency, more CPU and bandwidth",
                    "x-showWhen": "codec=opus"
                },
                "audioType": {
                    "type": "number",
                    "enum": [
                        0,
                        2048,
                        2049,
                        2051
                    ],
                    "x-enumLabels": {
                        "0": "Auto (Restricted Low-delay if frame size ≤ 5 ms, else Generic)",
                        "2048": "Generic",
                        "2049": "Voice",
                        "2051": "Restricted Low-delay"
                    },
                    "default": 0,
                    "title": "Audio Type",
                    "description": "Opus application type",
                    "x-showWhen": "codec=opus"
                },
                "inbandFec": {
                    "type": "boolean",
                    "default": false,
                    "title": "In-band FEC",
                    "description": "Only for audio sent without a reliable container (WebRTC). Off for RIST/SRT.",
                    "x-showWhen": "codec=opus"
                },
                "packetLoss": {
                    "type": "number",
                    "enum": [
                        0,
                        5,
                        10,
                        15,
                        20,
                        25,
                        30,
                        50
                    ],
                    "default": 10,
                    "title": "Expected Packet Loss",
                    "description": "Higher adds more redundancy",
                    "x-showWhen": "codec=opus"
                },
                "srcBufferMs": {
                    "type": "number",
                    "default": 200,
                    "minimum": 40,
                    "maximum": 1000,
                    "x-widget": "slider",
                    "x-step": 10,
                    "x-unit": "ms",
                    "title": "Capture Buffer",
                    "description": "Capture ring buffer. Lower only while measuring."
                },
                "tsAlignment": {
                    "type": "number",
                    "enum": [
                        0,
                        1,
                        7
                    ],
                    "x-enumLabels": {
                        "0": "Continuous",
                        "1": "One TS packet",
                        "7": "SRT-aligned (1316 B)"
                    },
                    "default": 7,
                    "title": "TS Alignment",
                    "description": "Keep SRT-aligned for SRT/RIST/UDP. Continuous only for v1-style byte-flow receivers."
                },
                "sampleRate": {
                    "type": "number",
                    "enum": [
                        44100,
                        48000
                    ],
                    "default": 48000,
                    "title": "Sample Rate",
                    "description": "Hz"
                },
                "channels": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 8,
                    "default": 2,
                    "description": "Number of audio channels"
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [
                        100,
                        150,
                        200,
                        300,
                        500
                    ],
                    "default": 150,
                    "title": "Volume Range",
                    "description": "Upper end of the volume slider"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "title": "Volume",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "Audio Enabled",
                    "description": "",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "title": "Show on LCP",
                    "description": "Show on the Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "title": "LCP Order",
                    "description": "Order on the Local Control Panel, lower = left"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Volume",
                    "description": "Allow volume control on the Local Control Panel"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Mute",
                    "description": "Allow mute control on the Local Control Panel"
                }
            }
        },
        "statusSections": [
            {
                "id": "udp",
                "label": "UDP Output",
                "fields": [
                    {
                        "key": "host",
                        "label": "Multicast"
                    },
                    {
                        "key": "port",
                        "label": "Port"
                    }
                ]
            },
            {
                "id": "encoder",
                "label": "Encoder",
                "fields": [
                    {
                        "key": "codec",
                        "label": "Codec"
                    },
                    {
                        "key": "bitrate",
                        "label": "Bitrate",
                        "unit": "kbps"
                    },
                    {
                        "key": "sampleRate",
                        "label": "Sample Rate",
                        "unit": "Hz"
                    },
                    {
                        "key": "channels",
                        "label": "Channels"
                    }
                ]
            },
            {
                "id": "throughput",
                "label": "Live Throughput",
                "fields": [
                    {
                        "key": "Output Bitrate",
                        "label": "Output Bitrate"
                    },
                    {
                        "key": "Total Bytes",
                        "label": "Total Bytes"
                    }
                ]
            }
        ],
        "engine": "./engine/AudioEncoderModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
