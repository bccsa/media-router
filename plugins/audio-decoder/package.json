{
    "name": "@media-router/plugin-audio-decoder",
    "version": "2.0.0",
    "private": true,
    "description": "Audio decoder \u2014 MPEG-TS input to PCM audio output",
    "mediaRouter": {
        "pluginId": "audio-decoder",
        "displayName": "Audio Decoder (Deprecated)",
        "description": "Decodes audio from MPEG-TS container (auto-detects Opus, AAC, MP2) and outputs PCM audio. Deprecated — use Audio Transcoder instead.",
        "color": "#8b5cf6",
        "icon": "download",
        "category": "deprecated",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "mpegts-in",
                "direction": "input",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS In",
                "maxConnections": 1
            },
            {
                "id": "audio-out",
                "direction": "output",
                "streamType": "audio/pcm",
                "label": "Audio Out",
                "maxConnections": -1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "channels": {
                    "type": "number",
                    "default": 2,
                    "description": "Auto-detected from the encoder",
                    "x-readOnly": true
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [
                        100,
                        150,
                        200,
                        300,
                        500
                    ],
                    "default": 150,
                    "title": "Volume Range",
                    "description": "Upper end of the volume slider"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "title": "Volume",
                    "description": "",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "Audio Enabled",
                    "description": "",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "title": "Show on LCP",
                    "description": "Show on the Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "title": "LCP Order",
                    "description": "Order on the Local Control Panel, lower = left"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Volume",
                    "description": "Allow volume control on the Local Control Panel"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "title": "LCP Mute",
                    "description": "Allow mute control on the Local Control Panel"
                }
            }
        },
        "engine": "./engine/AudioDecoderModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
