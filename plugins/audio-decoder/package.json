{
    "name": "@media-router/plugin-audio-decoder",
    "version": "2.0.0",
    "private": true,
    "description": "Audio decoder \u2014 MPEG-TS input to PCM audio output",
    "mediaRouter": {
        "pluginId": "audio-decoder",
        "displayName": "Audio Decoder",
        "description": "Decodes audio from MPEG-TS container (auto-detects Opus, AAC, MP2) and outputs PCM audio",
        "color": "#8b5cf6",
        "icon": "download",
        "category": "codec",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "mpegts-in",
                "direction": "input",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS In",
                "maxConnections": 1
            },
            {
                "id": "audio-out",
                "direction": "output",
                "streamType": "audio/pcm",
                "label": "Audio Out",
                "maxConnections": -1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "channels": {
                    "type": "number",
                    "default": 2,
                    "description": "Channels (auto-detected from encoder)",
                    "x-readOnly": true
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [
                        100,
                        150,
                        200,
                        300,
                        500
                    ],
                    "default": 150,
                    "description": "Maximum volume slider range (%)"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "description": "Volume (%)",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Audio enabled",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "slaveMethod": {
                    "type": "number",
                    "enum": [
                        0,
                        1
                    ],
                    "default": 0,
                    "description": "PulseAudio sync mode (0 = resample \u2014 prevents latency drift, 1 = skew)"
                },
                "bufferMs": {
                    "type": "number",
                    "default": 100,
                    "minimum": 0,
                    "maximum": 5000,
                    "x-widget": "slider",
                    "x-step": 50,
                    "x-unit": "ms",
                    "description": "Post-tsdemux jitter buffer (non-leaky). Unset defaults to 300. Keep low (50-100) for smooth splitter-fed live inputs — on re-encode paths its standing fill lands 1:1 as audio-late A/V skew; raise (e.g. 1500) for HLS or bursty demuxer-fed sources to absorb mid-stream join + decoder CPU spikes."
                },
                "sinkBufferMs": {
                    "type": "number",
                    "default": 200,
                    "minimum": 80,
                    "maximum": 1000,
                    "x-widget": "slider",
                    "x-step": 10,
                    "x-unit": "ms",
                    "description": "Audio sink ring buffer. 200 bridges the source's PES-burst spacing; lower only during a measured tuning pass (underflow/crackle risk). Contributes to the standing audio latency on re-encode paths."
                },
                "clockSync": {
                    "type": "boolean",
                    "default": false,
                    "description": "Lock to the shared engine clock so audio stays in sync with a video-player fed from the same source (no drift over time). Turn ON for both this decoder and the matching video-player when you split one stream into separate audio + video playout. Leave OFF for standalone/low-latency audio."
                },
                "lowLatencySync": {
                    "type": "boolean",
                    "default": false,
                    "description": "Deterministic playout anchor (lipsync fix for re-encode paths): render at PTS + Sync offset instead of on arrival, so the decoder→encoder loop stops accumulating standing latency into the re-encoded audio timeline. Late timelines (mid-stream joins, restarts) play immediately rather than going silent. Ignored when Clock sync is ON."
                },
                "syncOffsetMs": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "maximum": 2000,
                    "x-widget": "slider",
                    "x-step": 50,
                    "x-unit": "ms",
                    "description": "Optional pacing margin for Low-latency sync (0 = arrival-anchored, minimal latency). Raise toward the source's burst spacing (~150-200 ms) only if underflow gaps appear; whatever is set becomes standing audio latency."
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show on Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "description": "Display order on LCP (lower = left)"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow volume control on LCP"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow mute control on LCP"
                }
            }
        },
        "engine": "./engine/AudioDecoderModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
