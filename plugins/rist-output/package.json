{
    "name": "@media-router/plugin-rist-output",
    "version": "2.0.0",
    "private": true,
    "description": "RIST output \u2014 sends MPEG-TS stream over RIST protocol with bonding support",
    "mediaRouter": {
        "pluginId": "rist-output",
        "displayName": "RIST Output",
        "description": "Sends MPEG-TS stream over RIST (Reliable Internet Stream Transport). Supports multi-link bonding with per-link weight, cname, and encryption.",
        "color": "#0ea5e9",
        "icon": "radio-tower",
        "category": "protocol",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "mpegts-in",
                "direction": "input",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS In",
                "maxConnections": 1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "links": {
                    "type": "array",
                    "default": [
                        {
                            "mode": "caller",
                            "address": "localhost",
                            "port": 5004,
                            "weight": 50,
                            "cname": "link1"
                        }
                    ],
                    "title": "Links",
                    "description": "Several links bond for load balancing or backup",
                    "items": {
                        "type": "object",
                        "properties": {
                            "mode": {
                                "type": "string",
                                "enum": [
                                    "listener",
                                    "caller"
                                ],
                                "default": "caller",
                                "title": "Mode",
                                "description": ""
                            },
                            "address": {
                                "type": "string",
                                "default": "localhost",
                                "title": "Address",
                                "description": ""
                            },
                            "port": {
                                "type": "number",
                                "default": 5004,
                                "title": "Port",
                                "description": ""
                            },
                            "weight": {
                                "type": "number",
                                "default": 50,
                                "title": "Weight",
                                "description": "0 = backup, 1–100 = load balance"
                            },
                            "cname": {
                                "type": "string",
                                "default": "",
                                "title": "CNAME",
                                "description": "Link identifier"
                            }
                        }
                    }
                },
                "profile": {
                    "type": "number",
                    "enum": [
                        0,
                        1,
                        2
                    ],
                    "default": 1,
                    "description": "0 = simple, 1 = main, 2 = advanced"
                },
                "buffer": {
                    "type": "number",
                    "default": 1000,
                    "title": "Retransmission Buffer",
                    "description": "ms"
                },
                "secret": {
                    "type": "string",
                    "default": "",
                    "title": "Passphrase",
                    "description": "PSK passphrase"
                },
                "encryptionType": {
                    "type": "number",
                    "enum": [
                        0,
                        128,
                        256
                    ],
                    "default": 0,
                    "title": "Encryption",
                    "description": "0 = none, 128 = AES-128, 256 = AES-256"
                },
                "statsInterval": {
                    "type": "number",
                    "default": 1000,
                    "title": "Stats Interval",
                    "description": "ms"
                },
                "nullPacketDeletion": {
                    "type": "boolean",
                    "default": false,
                    "title": "Null Packet Deletion",
                    "description": "Receiver must support NPD"
                }
            }
        },
        "statusSections": [
            {
                "id": "connection",
                "label": "Connection",
                "fields": [
                    {
                        "key": "profile",
                        "label": "Profile"
                    },
                    {
                        "key": "linkCount",
                        "label": "Links"
                    },
                    {
                        "key": "encrypted",
                        "label": "Encrypted"
                    }
                ]
            },
            {
                "id": "stats",
                "label": "Live Stats",
                "fields": [
                    {
                        "key": "quality",
                        "label": "Quality",
                        "unit": "%"
                    },
                    {
                        "key": "sent",
                        "label": "Packets Sent"
                    },
                    {
                        "key": "retransmitted",
                        "label": "Retransmitted"
                    },
                    {
                        "key": "bandwidth",
                        "label": "Bandwidth"
                    },
                    {
                        "key": "rtt",
                        "label": "RTT",
                        "unit": "ms"
                    }
                ]
            }
        ],
        "engine": "./engine/RistOutputModule.ts",
        "faceWidgets": [
            {
                "id": "quality-meter",
                "type": "meter",
                "section": "stats",
                "key": "quality",
                "color": "#10b981"
            },
            {
                "id": "status-line",
                "type": "status-line",
                "section": "stats",
                "template": "Q: {quality} | BW: {bandwidth}"
            }
        ]
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-rist-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
