{
    "name": "@media-router/plugin-transcoder",
    "version": "2.0.0",
    "private": true,
    "description": "Video transcoder — one MPEG-TS video input fanned out to N re-encoded quality renditions (ABR ladder)",
    "mediaRouter": {
        "pluginId": "transcoder",
        "displayName": "Video Transcoder",
        "description": "Decodes one muxed/mpegts video stream once and re-encodes it into several quality renditions — set width, height and bitrate per output, each on its own MPEG-TS port. Input must be H.264 (the decoder is a fixed h264parse ! avdec_h264); the OUTPUT codec is configurable (H.264/H.265/AV1). Feeding an H.265 source produces no video.",
        "color": "#8b5cf6",
        "icon": "layers",
        "category": "codec",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "renditions": {
                    "type": "array",
                    "maxItems": 8,
                    "default": [
                        { "name": "1080p", "width": 1920, "height": 1080, "bitrate": 5000 },
                        { "name": "720p", "width": 1280, "height": 720, "bitrate": 2500 },
                        { "name": "480p", "width": 854, "height": 480, "bitrate": 1200 }
                    ],
                    "description": "Each rendition is an output port, re-encoded at its size and bitrate",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": { "type": "string", "default": "", "title": "Name", "description": "Optional label" },
                            "width": { "type": "number", "default": 1280, "minimum": 16, "maximum": 7680, "title": "Width", "description": "px" },
                            "height": { "type": "number", "default": 720, "minimum": 16, "maximum": 4320, "title": "Height", "description": "px" },
                            "bitrate": { "type": "number", "default": 2500, "minimum": 128, "maximum": 50000, "title": "Bitrate", "description": "kbps" },
                            "codec": {
                                "type": "string",
                                "enum": ["h264", "h265", "av1"],
                                "x-advanced": true,
                                "x-enumLabels": { "h264": "H.264", "h265": "H.265", "av1": "AV1" },
                                "title": "Codec",
                                "description": "Override for this rendition. Blank = inherit."
                            },
                            "encoderImpl": {
                                "type": "string",
                                "enum": ["auto", "v4l2", "va", "software"],
                                "x-advanced": true,
                                "x-enumLabels": {
                                    "auto": "Auto",
                                    "v4l2": "V4L2 hardware (Pi)",
                                    "va": "VA-API hardware (Intel iGPU)",
                                    "software": "Software (x264/x265)"
                                },
                                "title": "Encoder",
                                "description": "Override for this rendition. Blank = inherit."
                            },
                            "rateControl": {
                                "type": "string",
                                "enum": ["cbr", "vbr"],
                                "x-advanced": true,
                                "x-enumLabels": {
                                    "cbr": "CBR (constant)",
                                    "vbr": "VBR (variable)"
                                },
                                "title": "Rate Control",
                                "description": "Override for this rendition. Blank = inherit."
                            },
                            "speedPreset": {
                                "type": "string",
                                "enum": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow"],
                                "x-advanced": true,
                                "x-enumLabels": {
                                    "ultrafast": "Ultrafast",
                                    "superfast": "Superfast",
                                    "veryfast": "Very fast",
                                    "faster": "Faster",
                                    "fast": "Fast",
                                    "medium": "Medium",
                                    "slow": "Slow"
                                },
                                "x-showWhen": "encoderImpl=software,va,auto",
                                "title": "Speed Preset",
                                "description": "Override for this rendition. Raise on the top rendition only for cleaner motion."
                            },
                            "h264Profile": {
                                "type": "string",
                                "enum": ["auto", "baseline", "main", "high"],
                                "x-advanced": true,
                                "x-enumLabels": {
                                    "auto": "Auto",
                                    "baseline": "Baseline",
                                    "main": "Main",
                                    "high": "High"
                                },
                                "x-showWhen": "codec=h264",
                                "title": "H.264 Profile",
                                "description": "Override for this rendition. Blank = inherit."
                            },
                            "sceneCut": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100,
                                "x-advanced": true,
                                "x-showWhen": "encoderImpl=software,auto",
                                "title": "Scene Cut",
                                "description": "Override (software only; 0 = off). Blank = inherit."
                            },
                            "cpbSeconds": {
                                "type": "number",
                                "minimum": 0.1,
                                "maximum": 2,
                                "x-advanced": true,
                                "title": "CPB Depth",
                                "description": "Override for this rendition. Blank = inherit."
                            }
                        }
                    },
                    "x-liveUpdatable": false
                },
                "codec": {
                    "type": "string",
                    "enum": [
                        "h264",
                        "h265",
                        "av1"
                    ],
                    "default": "h264",
                    "description": "Applied to every rendition"
                },
                "rateControl": {
                    "type": "string",
                    "enum": ["cbr", "vbr"],
                    "default": "cbr",
                    "x-enumLabels": {
                        "cbr": "CBR (constant — safest for UDP/SRT)",
                        "vbr": "VBR (variable — better quality on motion)"
                    },
                    "title": "Rate Control",
                    "description": "CBR: constant bitrate, safest for fixed-bandwidth links. VBR: better motion quality, peak capped at 1.5x."
                },
                "encoderImpl": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "v4l2",
                        "va",
                        "software"
                    ],
                    "default": "auto",
                    "x-enumLabels": {
                        "auto": "Auto",
                        "v4l2": "V4L2 hardware (Pi)",
                        "va": "VA-API hardware (Intel iGPU)",
                        "software": "Software (x264/x265)"
                    },
                    "title": "Encoder",
                    "description": "Auto prefers hardware (V4L2 on Pi, VA-API on Intel), then software. Only installed options are listed."
                },
                "speedPreset": {
                    "type": "string",
                    "enum": [
                        "ultrafast",
                        "superfast",
                        "veryfast",
                        "faster",
                        "fast",
                        "medium",
                        "slow"
                    ],
                    "default": "ultrafast",
                    "x-enumLabels": {
                        "ultrafast": "Ultrafast — lowest CPU, lowest quality",
                        "superfast": "Superfast",
                        "veryfast": "Very fast",
                        "faster": "Faster",
                        "fast": "Fast",
                        "medium": "Medium — balanced",
                        "slow": "Slow — highest CPU, best quality"
                    },
                    "title": "Speed Preset",
                    "description": "x264/x265 speed vs quality. Faster = less CPU, blockier on hard content. Rebuilds the pipeline.",
                    "x-showWhen": "encoderImpl=software,va,auto"
                },
                "h264Profile": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "baseline",
                        "main",
                        "high"
                    ],
                    "default": "auto",
                    "x-enumLabels": {
                        "auto": "Auto — encoder default",
                        "baseline": "Baseline — most compatible",
                        "main": "Main",
                        "high": "High — best efficiency"
                    },
                    "title": "H.264 Profile",
                    "description": "Decoder compatibility. Baseline decodes everywhere, High is most efficient. Rebuilds the pipeline.",
                    "x-showWhen": "codec=h264"
                },
                "sceneCut": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 40,
                    "x-widget": "slider",
                    "x-step": 5,
                    "title": "Scene Cut",
                    "description": "Adaptive keyframe on hard cuts (software encoders only). 40 = x264 default, 0 = off.",
                    "x-showWhen": "encoderImpl=software,auto"
                },
                "cpbSeconds": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 2,
                    "default": 1,
                    "x-widget": "slider",
                    "x-step": 0.1,
                    "x-unit": "s",
                    "x-advanced": true,
                    "title": "CPB Depth",
                    "description": "Encoder burst bound in seconds of the rate cap. Lower to 0.3–0.5 s on links with little headroom.",
                    "x-showWhen": "encoderImpl=software,va,auto"
                },
                "framerate": {
                    "type": "number",
                    "enum": [
                        24,
                        25,
                        30,
                        50,
                        60
                    ],
                    "default": 50,
                    "title": "Frame Rate",
                    "description": "Shared by all renditions so keyframes stay aligned"
                },
                "deinterlace": {
                    "type": "string",
                    "enum": ["auto", "force", "off"],
                    "default": "auto",
                    "x-enumLabels": {
                        "auto": "Auto (deinterlace when interlaced)",
                        "force": "Force deinterlace",
                        "off": "Keep interlaced (pass-through)"
                    },
                    "description": "Auto deinterlaces interlaced sources. Keep interlaced only at source resolution."
                },
                "gopFrames": {
                    "type": "number",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 600,
                    "title": "GOP Length",
                    "description": "Keyframe interval in frames. Shorter = faster join, more bitrate. 50 = 1 s at 50 fps.",
                    "x-unit": "frames"
                },
                "cpuDecodeThreading": {
                    "type": "string",
                    "enum": ["multi", "single"],
                    "default": "multi",
                    "x-enumLabels": {
                        "multi": "Multi-core (spread decode across cores)",
                        "single": "Single core (lowest latency)"
                    },
                    "title": "CPU Decode Threading",
                    "description": "Multi-core spreads software decode across cores, ~1 frame latency per core. Single = lowest latency."
                },
                "bufferMs": {
                    "type": "number",
                    "minimum": 100,
                    "maximum": 2000,
                    "default": 200,
                    "title": "Buffer",
                    "description": "Jitter and decode-ahead buffer. Costs this much latency. Floored at 100 ms.",
                    "x-widget": "slider",
                    "x-step": 50,
                    "x-unit": "ms"
                },
                "preserveSourceTimeline": {
                    "type": "boolean",
                    "default": true,
                    "x-advanced": true,
                    "title": "Preserve Source Timeline",
                    "description": "Keep source timestamps so muxers align video with audio and lip-sync survives restarts."
                },
                "subtitlePosition": {
                    "type": "string",
                    "enum": ["bottom", "top", "center"],
                    "default": "bottom",
                    "x-enumLabels": { "bottom": "Bottom", "top": "Top", "center": "Center" },
                    "x-live": true,
                    "title": "Subtitle Position",
                    "description": "Vertical placement"
                },
                "subtitleAlign": {
                    "type": "string",
                    "enum": ["center", "left", "right"],
                    "default": "center",
                    "x-enumLabels": { "center": "Center", "left": "Left", "right": "Right" },
                    "x-live": true,
                    "title": "Subtitle Alignment",
                    "description": "Horizontal alignment"
                },
                "subtitleSize": {
                    "type": "number",
                    "default": 36,
                    "minimum": 12,
                    "maximum": 120,
                    "x-widget": "slider",
                    "x-step": 2,
                    "x-unit": "pt",
                    "x-live": true,
                    "title": "Subtitle Size",
                    "description": "Scales with picture height, so one value suits every output size"
                },
                "subtitleMargin": {
                    "type": "number",
                    "default": 40,
                    "minimum": 0,
                    "maximum": 400,
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "px",
                    "x-live": true,
                    "title": "Subtitle Margin",
                    "description": "Distance from the top or bottom edge; ignored for Center"
                },
                "subtitleBackground": {
                    "type": "boolean",
                    "default": true,
                    "x-live": true,
                    "title": "Subtitle Background",
                    "description": "Shaded box behind the text for legibility"
                },
                "subtitleBackgroundOpacity": {
                    "type": "number",
                    "default": 60,
                    "minimum": 0,
                    "maximum": 100,
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "%",
                    "x-live": true,
                    "x-showWhen": "subtitleBackground=true",
                    "title": "Subtitle Background Opacity",
                    "description": "0 = invisible, 100 = solid black"
                }
            }
        },
        "statusSections": [
            {
                "id": "input",
                "label": "Input",
                "fields": [
                    { "key": "host", "label": "Multicast" },
                    { "key": "port", "label": "Port" }
                ]
            },
            {
                "id": "encoder",
                "label": "Encoder",
                "fields": [
                    { "key": "codec", "label": "Codec" },
                    { "key": "impl", "label": "Implementation" },
                    { "key": "framerate", "label": "Framerate" },
                    { "key": "renditions", "label": "Renditions" }
                ]
            }
        ],
        "engine": "./engine/TranscoderModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-mpegts-core": "workspace:*",
        "@media-router/plugin-subtitle-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
