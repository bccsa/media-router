{
    "name": "@media-router/plugin-teletext-subtitles",
    "version": "2.0.0",
    "private": true,
    "description": "Teletext subtitle decoder — one MPEG-TS input carrying DVB teletext, one subtitle output per configured page",
    "mediaRouter": {
        "pluginId": "teletext-subtitles",
        "displayName": "Teletext Subtitles",
        "description": "Decodes the DVB teletext stream in an MPEG-TS once and turns each selected subtitle page into its own subtitle output. Pages the stream announces in its PMT appear under Detected Pages to pick from; Manual Pages covers anything unannounced. Wire a subtitle output into the Subtitles In port of a Video Player (rendered on the display) or a Video Transcoder (burned into every rendition). Subtitle outputs are MPEG-TS on the bus like everything else, so they also travel through SRT/RIST outputs and the MPEG-TS muxer.",
        "color": "#0ea5e9",
        "icon": "chat-bubble-bottom-center-text",
        "category": "codec",
        "architectures": ["arm64", "x86_64"],
        "ports": [],
        "configSchema": {
            "type": "object",
            "properties": {
                "detectedPages": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "x-optionsFrom": "announcedPages",
                    "title": "Detected Pages",
                    "description": "Pages announced in the stream's PMT, each pick becoming a subtitle output port.",
                    "x-liveUpdatable": false
                },
                "pages": {
                    "type": "array",
                    "maxItems": 8,
                    "default": [],
                    "title": "Manual Pages",
                    "description": "Pages to decode by number when the stream does not announce them.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "page": {
                                "type": "number",
                                "default": 888,
                                "minimum": 100,
                                "maximum": 899,
                                "title": "Page",
                                "description": "Decimal, 100–899"
                            },
                            "language": {
                                "type": "string",
                                "default": "",
                                "title": "Language",
                                "description": "ISO 639-2 code (eng, nor, fra)"
                            },
                            "name": {
                                "type": "string",
                                "default": "",
                                "title": "Name",
                                "description": "Defaults to language + page"
                            }
                        }
                    },
                    "x-liveUpdatable": false
                },
                "cueHoldSeconds": {
                    "type": "number",
                    "default": 8,
                    "minimum": 1,
                    "maximum": 30,
                    "x-unit": "s",
                    "title": "Cue Hold",
                    "description": "Longest a subtitle stays when the broadcaster never clears it"
                }
            }
        },
        "statusSections": [
            {
                "id": "input",
                "label": "Input",
                "fields": [
                    { "key": "channel", "label": "Bus channel" }
                ]
            },
            {
                "id": "detected",
                "label": "Detected",
                "fields": [
                    { "key": "pages", "label": "Announced pages" }
                ]
            },
            {
                "id": "cues",
                "label": "Subtitles",
                "fields": [
                    { "key": "pages", "label": "Pages" },
                    { "key": "total", "label": "Cues decoded" },
                    { "key": "last", "label": "Last cue" }
                ]
            }
        ],
        "engine": "./engine/TeletextSubtitlesModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-mpegts-core": "workspace:*",
        "@media-router/plugin-subtitle-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
