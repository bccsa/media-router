{
    "name": "@media-router/plugin-video-player",
    "version": "2.0.0",
    "private": true,
    "description": "Video player — MPEG-TS input rendered to a DRM/HDMI display",
    "mediaRouter": {
        "pluginId": "video-player",
        "displayName": "Video Player",
        "description": "Decodes an MPEG-TS video stream and renders it to a display via DRM/KMS",
        "color": "#8b5cf6",
        "icon": "monitor",
        "category": "protocol",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "mpegts-in",
                "direction": "input",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS In",
                "maxConnections": 1
            },
            {
                "id": "subtitles-in",
                "direction": "input",
                "streamType": "muxed/mpegts",
                "label": "Subtitles In",
                "maxConnections": 1,
                "acceptsStreamTypes": ["muxed/mpegts"]
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "display": {
                    "type": "string",
                    "default": "",
                    "description": "DRM connector",
                    "x-deviceType": "drm-connector"
                },
                "fallbackText": {
                    "type": "string",
                    "default": "No video detected",
                    "title": "Fallback Text",
                    "description": "Shown when no stream is connected",
                    "x-live": true
                },
                "fallbackImagePath": {
                    "type": "string",
                    "default": "",
                    "title": "Fallback Image",
                    "description": "Shown when no stream is connected; otherwise colour bars",
                    "x-widget": "imageUpload"
                },
                "bufferMs": {
                    "type": "number",
                    "default": 200,
                    "minimum": 0,
                    "maximum": 5000,
                    "x-widget": "slider",
                    "x-step": 50,
                    "x-unit": "ms",
                    "title": "Buffer",
                    "description": "Keep low (200) for live SRT/RIST; raise (1500) for HLS. Adds this much latency."
                },
                "sync": {
                    "type": "boolean",
                    "default": true,
                    "description": "On: smooth, timestamp-paced playback. Off: lowest latency, judder under jitter; fallback for broken PCR."
                },
                "lipSyncMs": {
                    "type": "number",
                    "default": 0,
                    "minimum": -2000,
                    "maximum": 2000,
                    "x-widget": "slider",
                    "x-step": 50,
                    "x-unit": "ms",
                    "x-live": true,
                    "title": "Lip-Sync Trim",
                    "description": "Trim on top of the route's playout offset for this display. Positive delays video. Needs Sync on."
                },
                "cpuDecodeThreading": {
                    "type": "string",
                    "enum": ["auto", "single"],
                    "default": "auto",
                    "x-enumLabels": {
                        "auto": "Auto (multi-core)",
                        "single": "Single core (lowest latency)"
                    },
                    "title": "CPU Decode Threading",
                    "description": "Software decode only. Auto uses three cores (~60 ms latency); Single adds none but must keep up."
                },
                "subtitlePosition": {
                    "type": "string",
                    "enum": ["bottom", "top", "center"],
                    "default": "bottom",
                    "x-enumLabels": { "bottom": "Bottom", "top": "Top", "center": "Center" },
                    "x-live": true,
                    "title": "Subtitle Position",
                    "description": "Vertical placement"
                },
                "subtitleAlign": {
                    "type": "string",
                    "enum": ["center", "left", "right"],
                    "default": "center",
                    "x-enumLabels": { "center": "Center", "left": "Left", "right": "Right" },
                    "x-live": true,
                    "title": "Subtitle Alignment",
                    "description": "Horizontal alignment"
                },
                "subtitleSize": {
                    "type": "number",
                    "default": 36,
                    "minimum": 12,
                    "maximum": 120,
                    "x-widget": "slider",
                    "x-step": 2,
                    "x-unit": "pt",
                    "x-live": true,
                    "title": "Subtitle Size",
                    "description": "Scales with picture height, so one value suits every output size"
                },
                "subtitleMargin": {
                    "type": "number",
                    "default": 40,
                    "minimum": 0,
                    "maximum": 400,
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "px",
                    "x-live": true,
                    "title": "Subtitle Margin",
                    "description": "Distance from the top or bottom edge; ignored for Center"
                },
                "subtitleBackground": {
                    "type": "boolean",
                    "default": true,
                    "x-live": true,
                    "title": "Subtitle Background",
                    "description": "Shaded box behind the text for legibility"
                },
                "subtitleBackgroundOpacity": {
                    "type": "number",
                    "default": 60,
                    "minimum": 0,
                    "maximum": 100,
                    "x-widget": "slider",
                    "x-step": 5,
                    "x-unit": "%",
                    "x-live": true,
                    "x-showWhen": "subtitleBackground=true",
                    "title": "Subtitle Background Opacity",
                    "description": "0 = invisible, 100 = solid black"
                }
            }
        },
        "uploads": {
            "extensions": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp"],
            "maxBytes": 10485760
        },
        "statusSections": [
            {
                "id": "input",
                "label": "Input",
                "fields": [
                    { "key": "source", "label": "Source" },
                    { "key": "state", "label": "State" }
                ]
            },
            {
                "id": "display",
                "label": "Display",
                "fields": [
                    { "key": "renderer", "label": "Renderer" },
                    { "key": "target", "label": "Output" },
                    { "key": "status", "label": "Status" }
                ]
            }
        ],
        "engine": "./engine/VideoPlayerModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-subtitle-core": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
