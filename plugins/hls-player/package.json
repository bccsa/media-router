{
    "name": "@media-router/plugin-hls-player",
    "version": "2.0.0",
    "private": true,
    "description": "HLS Player — pulls an HLS stream and outputs MPEG-TS (powered by hls-pipe)",
    "mediaRouter": {
        "pluginId": "hls-player",
        "displayName": "HLS Player",
        "description": "Pulls an HLS stream (live or VOD) via hls-pipe and outputs MPEG-TS. ABR with mid-fragment abandon, fMP4/CMAF + MPEG-TS sources, AES-128, multi-language audio and inline WebVTT subtitles. Audio and subtitle languages are auto-detected from the playlist.",
        "color": "#0ea5e9",
        "icon": "tv",
        "category": "protocol",
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "mpegts-out",
                "direction": "output",
                "streamType": "muxed/mpegts",
                "label": "MPEG-TS Out",
                "maxConnections": -1,
                "requiresOrderedApply": true
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "url": {
                    "type": "string",
                    "default": "",
                    "x-live": true,
                    "x-debounceMs": 800,
                    "title": "Playlist URL",
                    "description": "Master or media .m3u8. Paste to detect languages."
                },
                "quality": {
                    "type": "string",
                    "enum": ["auto", "max1080", "max720", "max480", "max360", "lowest"],
                    "default": "auto",
                    "x-enumLabels": {
                        "auto": "Auto — best available",
                        "max1080": "Auto — up to 1080p",
                        "max720": "Auto — up to 720p",
                        "max480": "Auto — up to 480p",
                        "max360": "Auto — up to 360p",
                        "lowest": "Lowest (data saver)"
                    },
                    "description": "Cap how high Auto goes. Pick the highest your device decodes smoothly (720p on a Pi 5)."
                },
                "abrPreset": {
                    "type": "string",
                    "enum": ["default", "unstable"],
                    "default": "default",
                    "x-enumLabels": {
                        "default": "Default",
                        "unstable": "Unstable network"
                    },
                    "x-showWhen": "quality=auto,max1080,max720,max480,max360",
                    "title": "ABR Preset",
                    "description": "'Unstable' reacts faster on slow or lossy networks"
                },
                "audioLanguages": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "x-optionsFrom": "audio",
                    "title": "Audio Languages",
                    "description": "None = all detected. Restart to apply."
                },
                "subtitleLanguages": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "x-optionsFrom": "subtitles",
                    "title": "Subtitle Languages",
                    "description": "Multiplexed inline. None = off. Restart to apply."
                },
                "allowMonoAudio": {
                    "type": "boolean",
                    "default": false,
                    "title": "Allow Mono Audio",
                    "description": "Permit mono-only audio groups"
                },
                "liveStartSegments": {
                    "type": "number",
                    "default": 6,
                    "title": "Live Start Segments",
                    "description": "Segments behind the live edge to start at"
                },
                "liveSyncSec": {
                    "type": "number",
                    "default": 0,
                    "x-unit": "s",
                    "title": "Live Sync",
                    "description": "Target latency from the live edge. 0 = auto."
                },
                "liveMaxLagSec": {
                    "type": "number",
                    "default": 30,
                    "x-unit": "s",
                    "title": "Live Max Lag",
                    "description": "Lag tolerated before Skip on stall acts"
                },
                "skipOnStall": {
                    "type": "boolean",
                    "default": false,
                    "title": "Skip on Stall",
                    "description": "Jump to the live edge when max lag is exceeded"
                }
            }
        },
        "statusSections": [
            {
                "id": "source",
                "label": "Source",
                "fields": [
                    { "key": "playlist", "label": "Playlist" },
                    { "key": "quality", "label": "Quality" },
                    { "key": "audio", "label": "Audio" },
                    { "key": "subtitles", "label": "Subtitles" }
                ]
            },
            {
                "id": "stats",
                "label": "Live Stats",
                "fields": [
                    { "key": "bitrate", "label": "Bitrate", "unit": "Mbps" },
                    { "key": "data", "label": "Data Sent" }
                ]
            }
        ],
        "engine": "./engine/HlsPlayerModule.ts"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*",
        "@media-router/plugin-unixfdbus-core": "workspace:*",
        "hls-pipe": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    }
}
