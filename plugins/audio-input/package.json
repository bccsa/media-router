{
    "name": "@media-router/plugin-audio-input",
    "version": "2.0.0",
    "private": true,
    "description": "Audio input \u2014 captures audio from a PipeWire/PulseAudio source device",
    "mediaRouter": {
        "pluginId": "audio-input",
        "displayName": "Audio Input (Deprecated)",
        "description": "Captures audio from a system audio source (microphone, line-in, or virtual device). Deprecated — use Audio Input (302M) instead.",
        "color": "#3b82f6",
        "icon": "mic",
        "category": "deprecated",
        "interlock": true,
        "architectures": [
            "arm64",
            "x86_64"
        ],
        "ports": [
            {
                "id": "audio-out",
                "direction": "output",
                "streamType": "audio/pcm",
                "label": "Audio Out",
                "maxConnections": -1
            }
        ],
        "configSchema": {
            "type": "object",
            "properties": {
                "device": {
                    "type": "string",
                    "default": "",
                    "description": "Select audio source device",
                    "x-deviceType": "audio-source"
                },
                "sampleRate": {
                    "type": "number",
                    "description": "Sample rate (auto-detected from device)",
                    "x-readOnly": true
                },
                "channels": {
                    "type": "number",
                    "description": "Channels (auto-detected from device)",
                    "x-readOnly": true
                },
                "volumeMax": {
                    "type": "number",
                    "enum": [
                        100,
                        150,
                        200,
                        300,
                        500
                    ],
                    "default": 150,
                    "description": "Maximum volume slider range (%)"
                },
                "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 150,
                    "default": 100,
                    "description": "Input volume (%)",
                    "x-widget": "slider",
                    "x-step": 1,
                    "x-live": true,
                    "x-maxFrom": "volumeMax",
                    "x-contextMenu": true,
                    "x-unit": "%"
                },
                "audioEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Audio enabled",
                    "x-live": true,
                    "x-contextMenu": true
                },
                "lcpVisible": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show on Local Control Panel"
                },
                "lcpSortOrder": {
                    "type": "number",
                    "default": 0,
                    "description": "Display order on LCP (lower = left)"
                },
                "lcpVolumeEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow volume control on LCP"
                },
                "lcpMuteEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Allow mute control on LCP"
                }
            }
        },
        "engine": "./engine/AudioInputModule.ts",
        "lcpType": "mixer-strip"
    },
    "dependencies": {
        "@media-router/engine": "workspace:*"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^25.5.0"
    }
}
