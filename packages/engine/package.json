{
    "name": "@media-router/engine",
    "version": "2.0.0",
    "private": true,
    "description": "Media Router engine — plugin host, module manager, media routing",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./dist/plugins/PacedUdpTsSink.js": {
            "types": "./dist/plugins/PacedUdpTsSink.d.ts",
            "default": "./dist/plugins/PacedUdpTsSink.js"
        },
        "./dist/plugins/PacedUnixStreamTsSink.js": {
            "types": "./dist/plugins/PacedUnixStreamTsSink.d.ts",
            "default": "./dist/plugins/PacedUnixStreamTsSink.js"
        }
    },
    "scripts": {
        "build": "tsc && cp src/child-process/gst-pipeline-runner.py src/child-process/gst-net-clock.py src/child-process/librist.py src/child-process/ts_psi.py src/child-process/ts_timeline.py src/child-process/sps_parse.py src/child-process/ts_video_info.py src/child-process/unixfd-fanout.py dist/child-process/",
        "typecheck": "tsc --noEmit",
        "dev": "bash -c '[ -f .env.local ] && . ./.env.local; exec tsx watch --inspect=9230 examples/test-engine.ts'"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@media-router/dgram-comms": "workspace:*",
        "@media-router/shared-types": "workspace:*",
        "ajv": "^8.18.0",
        "fastify": "^5.8.2",
        "socket.io": "^4.8.3"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "socket.io-client": "^4.8.3",
        "tsx": "^4.21.0"
    }
}
