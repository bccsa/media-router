        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@media-router/shared-types": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3"
    }
