{
    "name": "@media-router/topic-tree",
    "version": "2.0.0",
    "private": true,
    "description": "Server side of the subscribable tree (ADR-0024): subscriptions, per-socket delivery, write/call dispatch",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
