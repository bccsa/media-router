{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "router.js",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/server/router.js"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "manager.js",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/server/manager.js"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Test Gstreamer c++ (GstGeneric)",
            "cwd": "${workspaceFolder}/server/gst_modules/GstGeneric",
            "preLaunchTask": "npm: build:gst:dev",
            "program": "/usr/bin/node",
            "args": [
               "./test.js"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "v2: Manager (dev)",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["--filter", "@media-router/manager", "dev"],
            "cwd": "${workspaceFolder}/v2",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "v2: Engine (dev)",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["--filter", "@media-router/engine", "dev"],
            "cwd": "${workspaceFolder}/v2",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "attach",
            "name": "v2: Attach Manager (9229)",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"],
            "restart": true
        },
        {
            "type": "node",
            "request": "attach",
            "name": "v2: Attach Engine (9230)",
            "port": 9230,
            "skipFiles": ["<node_internals>/**"],
            "restart": true
        },
    ],
    "compounds": [
        {
            "name": "v2: Manager + Engine",
            "configurations": ["v2: Manager (dev)", "v2: Engine (dev)"]
        }
    ]
}