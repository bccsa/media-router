{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Manager (dev)",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["--filter", "@media-router/manager", "dev"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Engine (dev)",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "pnpm",
            "runtimeArgs": ["--filter", "@media-router/engine", "dev"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach Manager (9229)",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"],
            "restart": true
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach Engine (9230)",
            "port": 9230,
            "skipFiles": ["<node_internals>/**"],
            "restart": true
        }
    ],
    "compounds": [
        {
            "name": "Manager + Engine",
            "configurations": ["Manager (dev)", "Engine (dev)"]
        }
    ]
}
