{
    "name": "@media-router/root",
    "version": "2.0.0",
    "private": true,
    "description": "Media Router v2.0 — Distributed media routing system",
    "scripts": {
        "build": "pnpm -r --filter './packages/*' run build",
        "dev": "pnpm -r --parallel --filter './packages/*' run dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "pnpm -r --filter './packages/*' run typecheck",
        "lint": "prettier --check 'packages/*/src/**/*.{ts,vue}' 'plugins/*/engine/**/*.ts'",
        "format": "prettier --write 'packages/*/src/**/*.{ts,vue}' 'plugins/*/engine/**/*.ts'"
    },
    "devDependencies": {
        "prettier": "^3.5.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
    }
}
